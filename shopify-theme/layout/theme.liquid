<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Les réglages du thème pilotent les variables CSS. {%- endcomment -%}
  {% style %}
    :root {
      --bg: {{ settings.color_bg }};
      --bg-soft: {{ settings.color_bg_soft }};
      --bg-tint: {{ settings.color_bg_soft | color_darken: 3 }};
      --text: {{ settings.color_text }};
      --text-soft: {{ settings.color_text | color_lighten: 20 }};
      --muted: {{ settings.color_muted }};
      --line: {{ settings.color_line }};
      --line-strong: {{ settings.color_line | color_darken: 8 }};
      --accent: {{ settings.color_accent }};
      --accent-text: {{ settings.color_accent_text }};
      --radius: {{ settings.radius_card }}px;
      --radius-lg: {{ settings.radius_card | plus: 8 }}px;
      --ratio-produit: {{ settings.product_image_ratio }};
    }
  {% endstyle %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip-link" href="#contenu">Aller au contenu</a>

  {% section 'header' %}

  <main id="contenu" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
</body>
</html>
