[
  {
    "name": "theme_info",
    "theme_name": "ORBIT",
    "theme_version": "1.0.0",
    "theme_author": "ORBIT",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Identité",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Sans logo, le nom de la boutique s'affiche en texte."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Largeur du logo",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Image carrée, 96 × 96 px minimum."
      }
    ]
  },
  {
    "name": "Thème clair / sombre",
    "settings": [
      {
        "type": "select",
        "id": "theme_defaut",
        "label": "Thème par défaut",
        "info": "Le visiteur peut changer à tout moment ; son choix est mémorisé.",
        "options": [
          {
            "value": "sombre",
            "label": "Sombre"
          },
          {
            "value": "clair",
            "label": "Clair"
          },
          {
            "value": "systeme",
            "label": "Suivre le réglage de l'appareil"
          }
        ],
        "default": "clair"
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "header",
        "content": "Mode clair"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Couleur principale",
        "default": "#b4654a"
      },
      {
        "type": "color",
        "id": "color_accent_2",
        "label": "Couleur secondaire",
        "default": "#d9a05b"
      },
      {
        "type": "color",
        "id": "color_accent_ink",
        "label": "Texte sur la couleur principale",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Mode sombre"
      },
      {
        "type": "color",
        "id": "color_accent_sombre",
        "label": "Couleur principale",
        "default": "#d98366"
      },
      {
        "type": "color",
        "id": "color_accent_2_sombre",
        "label": "Couleur secondaire",
        "default": "#e8bb7c"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_titres",
        "label": "Police des titres",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_texte",
        "label": "Police du texte",
        "default": "assistant_n4"
      },
      {
        "type": "select",
        "id": "titres_casse",
        "label": "Casse des titres",
        "options": [
          {
            "value": "none",
            "label": "Normale"
          },
          {
            "value": "uppercase",
            "label": "Majuscules"
          }
        ],
        "default": "none"
      },
      {
        "type": "range",
        "id": "titres_espacement",
        "min": -2,
        "max": 6,
        "step": 0.5,
        "unit": "px",
        "label": "Espacement des titres",
        "default": 0
      },
      {
        "type": "range",
        "id": "titres_graisse",
        "min": 400,
        "max": 800,
        "step": 100,
        "label": "Graisse des titres",
        "default": 700
      }
    ]
  },
  {
    "name": "Mise en forme",
    "settings": [
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Arrondi des cartes",
        "default": 8
      },
      {
        "type": "select",
        "id": "product_ratio",
        "label": "Format des images produit",
        "options": [
          {
            "value": "1 / 1",
            "label": "Carré"
          },
          {
            "value": "4 / 3",
            "label": "Paysage 4:3"
          },
          {
            "value": "3 / 4",
            "label": "Portrait 3:4"
          }
        ],
        "default": "3 / 4"
      },
      {
        "type": "header",
        "content": "Images de la page produit"
      },
      {
        "type": "select",
        "id": "fiche_ratio",
        "label": "Format d'affichage",
        "info": "« Adapté à l'image » évite tout recadrage.",
        "options": [
          {
            "value": "auto",
            "label": "Adapté à l'image"
          },
          {
            "value": "1 / 1",
            "label": "Carré"
          },
          {
            "value": "4 / 3",
            "label": "Paysage"
          },
          {
            "value": "3 / 4",
            "label": "Portrait"
          }
        ],
        "default": "3 / 4"
      },
      {
        "type": "select",
        "id": "fiche_ajustement",
        "label": "Ajustement",
        "info": "« Image entière » ne coupe aucune partie de la photo.",
        "options": [
          {
            "value": "contain",
            "label": "Image entière"
          },
          {
            "value": "cover",
            "label": "Remplir le cadre"
          }
        ],
        "default": "contain"
      },
      {
        "type": "color",
        "id": "fiche_fond",
        "label": "Fond derrière les images",
        "default": "#f6f2ec"
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "number",
        "id": "seuil_livraison_gratuite",
        "label": "Seuil de livraison offerte",
        "info": "En euros. Mettez 0 pour masquer la jauge de progression.",
        "default": 60
      }
    ]
  },
  {
    "name": "Pages spéciales",
    "settings": [
      {
        "type": "page",
        "id": "page_favoris",
        "label": "Page Favoris",
        "info": "Créez une page utilisant le modèle « favoris », puis sélectionnez-la ici."
      },
      {
        "type": "page",
        "id": "page_comparateur",
        "label": "Page Comparateur",
        "info": "Créez une page utilisant le modèle « comparateur », puis sélectionnez-la ici."
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_x",
        "label": "X"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Image de partage par défaut",
        "info": "1200 × 628 px."
      }
    ]
  }
]
