<div class="container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>{{ blog.title }}
  </nav>
</div>

<section class="section" style="padding-top:32px">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Journal</p>
        <h1 style="font-size:clamp(1.6rem,3.4vw,2.3rem)">{{ blog.title }}</h1>
      </div>
    </div>

    {% paginate blog.articles by 9 %}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <article class="article-card">
            <a href="{{ article.url }}">
              <div class="article-card__media">
                {%- if article.image -%}
                  <img src="{{ article.image | image_url: width: 800 }}" loading="lazy"
                       width="800" height="500"
                       alt="{{ article.image.alt | default: article.title | escape }}">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: '%d %B %Y' }}
              </time>
              <h3>{{ article.title }}</h3>
            </a>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </article>
        {%- else -%}
          <p class="empty-state">Aucun article publié pour le moment.</p>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
