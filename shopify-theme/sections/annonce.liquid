{%- if section.settings.texte != blank -%}
  <div class="annonce">
    <span>{{ section.settings.texte }}</span>
    {%- if section.settings.lien_texte != blank -%}
      <a href="{{ section.settings.lien }}">{{ section.settings.lien_texte }}</a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'annonce",
  "settings": [
    {
      "type": "text",
      "id": "texte",
      "label": "Message",
      "default": "Livraison offerte dès 60 € · Retour gratuit sous 30 jours"
    },
    { "type": "text", "id": "lien_texte", "label": "Texte du lien" },
    { "type": "url", "id": "lien", "label": "Lien" }
  ]
}
{% endschema %}
