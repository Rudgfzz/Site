<section class="section{% if section.settings.fond_alterne %} section--soft{% endif %}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.surtitre != blank -%}
          <p class="eyebrow">{{ section.settings.surtitre }}</p>
        {%- endif -%}
        <h2>{{ section.settings.titre }}</h2>
        {%- if section.settings.texte != blank -%}
          <p>{{ section.settings.texte }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.collection.url }}">Tout voir</a>
      {%- endif -%}
    </div>

    <div class="grid-products">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.nombre -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="empty-state">Cette collection ne contient encore aucun produit.</p>
        {%- endfor -%}
      {%- else -%}
        <p class="empty-state">
          Choisissez une collection dans les réglages de cette section.
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produits mis en avant",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Sélection" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Les plus demandés" },
    {
      "type": "text",
      "id": "texte",
      "label": "Texte",
      "default": "Une poignée de produits qui reviennent dans presque toutes les commandes."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "nombre",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Nombre de produits",
      "default": 4
    },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond gris clair", "default": true }
  ],
  "presets": [{ "name": "Produits mis en avant" }]
}
{% endschema %}
