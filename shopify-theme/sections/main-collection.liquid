{%- comment -%}
  Page collection ORBIT.
  Les filtres proviennent de l'application gratuite « Search & Discovery ».
  Sans elle, la colonne de gauche affiche simplement les autres collections.
{%- endcomment -%}

<div class="container">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>{{ collection.title }}
  </nav>
</div>

<section class="section" style="padding-top:26px">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.surtitre != blank -%}<p class="eyebrow">{{ section.settings.surtitre }}</p>{%- endif -%}
        <h1 style="font-size:clamp(1.8rem,3.6vw,2.6rem)">{{ collection.title }}</h1>
        {%- if collection.description != blank and section.settings.afficher_description -%}
          <div>{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </div>

    <div class="boutique">
      {%- if section.settings.afficher_filtres -%}
      <aside class="facettes" aria-label="Filtres">
        <form id="form-filtres" method="get">
          {%- comment -%} Conserve la recherche en cours lors du filtrage. {%- endcomment -%}
          {%- if collection.sort_by != blank -%}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {%- endif -%}

          {%- if collection.filters.size > 0 -%}
            {%- for filtre in collection.filters -%}
              <div class="facette">
                <details open>
                  <summary>{{ filtre.label }}</summary>

                  {%- case filtre.type -%}
                    {%- when 'list' -%}
                      {%- assign nom_filtre = filtre.label | downcase -%}
                      {%- if nom_filtre contains 'couleur' or nom_filtre contains 'color' -%}
                        <div class="pastilles-couleur">
                          {%- for valeur in filtre.values -%}
                            {%- capture hex -%}{% render 'pastille-couleur', valeur: valeur.label %}{%- endcapture -%}
                            <label title="{{ valeur.label | escape }}">
                              <input type="checkbox" class="sr-only" data-filtre-auto
                                     name="{{ valeur.param_name }}" value="{{ valeur.value }}"
                                     {% if valeur.active %}checked{% endif %}>
                              <span class="pastille-couleur" aria-hidden="true"
                                    style="background:{{ hex | strip }};display:block"
                                    data-actif="{{ valeur.active }}"></span>
                              <span class="sr-only">{{ valeur.label }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        <div class="facette__liste">
                          {%- for valeur in filtre.values -%}
                            <label class="coche">
                              <input type="checkbox" data-filtre-auto
                                     name="{{ valeur.param_name }}" value="{{ valeur.value }}"
                                     {% if valeur.active %}checked{% endif %}
                                     {% if valeur.count == 0 and valeur.active == false %}disabled{% endif %}>
                              <span>{{ valeur.label }}</span>
                              <span class="compte">{{ valeur.count }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                    {%- when 'price_range' -%}
                      <div class="plage-prix">
                        <label class="sr-only" for="prix-min">Prix minimum</label>
                        <input class="input" id="prix-min" type="number" inputmode="numeric"
                               name="{{ filtre.min_value.param_name }}" placeholder="0"
                               value="{% if filtre.min_value.value %}{{ filtre.min_value.value | money_without_currency | replace: ',', '.' }}{% endif %}"
                               min="0" max="{{ filtre.range_max | money_without_currency | replace: ',', '.' }}">
                        <span>à</span>
                        <label class="sr-only" for="prix-max">Prix maximum</label>
                        <input class="input" id="prix-max" type="number" inputmode="numeric"
                               name="{{ filtre.max_value.param_name }}"
                               placeholder="{{ filtre.range_max | money_without_currency }}"
                               value="{% if filtre.max_value.value %}{{ filtre.max_value.value | money_without_currency | replace: ',', '.' }}{% endif %}"
                               min="0" max="{{ filtre.range_max | money_without_currency | replace: ',', '.' }}">
                      </div>
                      <button class="btn btn--soft btn--sm btn--block" type="submit" style="margin-top:10px">
                        Appliquer
                      </button>
                  {%- endcase -%}
                </details>
              </div>
            {%- endfor -%}

            <a class="btn btn--ghost btn--block btn--sm" href="{{ collection.url }}" style="margin-top:16px">
              Tout effacer
            </a>

          {%- else -%}
            <div class="facette">
              <h3>Catégories</h3>
              <div class="facette__liste">
                {%- for autre in collections -%}
                  <a class="coche" href="{{ autre.url }}">
                    <span>{{ autre.title }}</span>
                    <span class="compte">{{ autre.products_count }}</span>
                  </a>
                {%- endfor -%}
              </div>
            </div>
            <p class="form-note" style="margin-top:14px">
              Pour filtrer par marque, coloris ou prix, installez l'application gratuite
              Shopify « Search &amp; Discovery ».
            </p>
          {%- endif -%}
        </form>
      </aside>
      {%- endif -%}

      <div>
        <div class="barre-outils">
          <span class="compteur-resultats">
            {{ collection.products_count }} produit{% if collection.products_count > 1 %}s{% endif %}
          </span>

          <div class="barre-outils__droite">
            <form method="get" id="form-tri">
              {%- comment -%} Reporte les filtres actifs pour ne pas les perdre au tri. {%- endcomment -%}
              {%- for filtre in collection.filters -%}
                {%- for valeur in filtre.active_values -%}
                  <input type="hidden" name="{{ valeur.param_name }}" value="{{ valeur.value }}">
                {%- endfor -%}
                {%- if filtre.type == 'price_range' -%}
                  {%- if filtre.min_value.value -%}
                    <input type="hidden" name="{{ filtre.min_value.param_name }}" value="{{ filtre.min_value.value }}">
                  {%- endif -%}
                  {%- if filtre.max_value.value -%}
                    <input type="hidden" name="{{ filtre.max_value.param_name }}" value="{{ filtre.max_value.value }}">
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              <label class="sr-only" for="tri">Trier</label>
              <select class="select" id="tri" name="sort_by">
                {%- assign tri_actuel = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == tri_actuel %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
              <noscript><button class="btn btn--soft btn--sm" type="submit">Trier</button></noscript>
            </form>

            {%- if section.settings.afficher_vue -%}
            <div class="bascule-vue" role="group" aria-label="Affichage">
              <button type="button" data-vue="grille" aria-pressed="true" aria-label="Vue grille">
                {% render 'icon', nom: 'grille' %}
              </button>
              <button type="button" data-vue="liste" aria-pressed="false" aria-label="Vue liste">
                {% render 'icon', nom: 'liste' %}
              </button>
            </div>
            {%- endif -%}
          </div>
        </div>

        {%- if collection.filters.size > 0 -%}
          <div class="jetons">
            {%- for filtre in collection.filters -%}
              {%- for valeur in filtre.active_values -%}
                <a class="jeton" href="{{ valeur.url_to_remove }}">
                  {{ filtre.label }} : {{ valeur.label }} <span aria-hidden="true">×</span>
                  <span class="sr-only">Retirer ce filtre</span>
                </a>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {% paginate collection.products by section.settings.par_page %}
          <div class="grille-produits" id="grille-boutique" data-vue="grille">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- else -%}
              <div class="vide">
                <h3>{{ section.settings.titre_vide }}</h3>
                <p>{{ section.settings.texte_vide }}</p>
                <a class="btn btn--ghost" href="{{ collection.url }}">Tout effacer</a>
              </div>
            {%- endfor -%}
          </div>

          {% render 'pagination', paginate: paginate %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page collection",
  "settings": [
    {
      "type": "range",
      "id": "par_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Produits par page",
      "default": 12
    },
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Catalogue" },
    { "type": "checkbox", "id": "afficher_description", "label": "Afficher la description de la collection", "default": true },
    { "type": "checkbox", "id": "afficher_filtres", "label": "Afficher la colonne de filtres", "default": true },
    { "type": "checkbox", "id": "afficher_vue", "label": "Afficher le choix grille / liste", "default": true },
    { "type": "text", "id": "titre_vide", "label": "Titre si aucun produit", "default": "Aucun produit" },
    { "type": "text", "id": "texte_vide", "label": "Texte si aucun produit", "default": "Essayez d'élargir vos critères ou effacez les filtres." }
  ]
}
{% endschema %}
