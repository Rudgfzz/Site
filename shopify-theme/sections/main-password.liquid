<div class="password-page">
  <div>
    <a class="logo" href="{{ routes.root_url }}" style="justify-content:center;margin-bottom:22px">
      {% render 'icon', nom: 'logo' %}
      {{ shop.name }}
    </a>

    <h1>{{ section.settings.titre }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="lead" style="margin-inline:auto">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div class="alerte alerte--err">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label for="mot-de-passe">Mot de passe de la boutique</label>
        <input class="input" id="mot-de-passe" type="password" name="password" required>
      </div>

      <button class="btn btn--block" type="submit">Entrer</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Bientôt ouvert"
    }
  ]
}
{% endschema %}
