{%- liquid
  assign v = product.selected_or_first_available_variant
  assign note = product.metafields.reviews.rating.value
  assign nb_avis = product.metafields.reviews.rating_count.value

  # Format d'affichage de la galerie.
  case section.settings.ratio_image
    when 'auto'
      assign ratio_css = product.featured_media.aspect_ratio | default: 1.0
    when 'carre'
      assign ratio_css = 1.0
    when 'paysage'
      assign ratio_css = 1.3333
    when 'portrait'
      assign ratio_css = 0.75
    else
      assign ratio_css = 1.0
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .galerie__principale {
    aspect-ratio: {{ ratio_css }};
    background: {{ section.settings.fond_images }};
    {% if section.settings.ajustement == 'contain' %}padding: 4%;{% endif %}
  }
  #shopify-section-{{ section.id }} .galerie__vignettes button {
    background: {{ section.settings.fond_images }};
  }
  #shopify-section-{{ section.id }} .galerie__principale img {
    object-fit: {{ section.settings.ajustement }};
  }
  #shopify-section-{{ section.id }} .galerie__vignettes button {
    aspect-ratio: {{ ratio_css }};
  }
  #shopify-section-{{ section.id }} .galerie__vignettes img {
    object-fit: {{ section.settings.ajustement }};
  }
  {% unless section.settings.galerie_collante %}
    #shopify-section-{{ section.id }} .galerie { position: static; }
  {% endunless %}
{% endstyle %}

<div class="container">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Boutique</a><span>/</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div id="fiche-produit">
    <div class="fiche">
      {%- comment -%} ---------- Galerie ---------- {%- endcomment -%}
      <div class="galerie">
        <div class="galerie__principale">
          {%- if product.featured_media -%}
            <img id="image-produit"
                 src="{{ product.featured_media | image_url: width: 1400 }}"
                 srcset="{{ product.featured_media | image_url: width: 600 }} 600w,
                         {{ product.featured_media | image_url: width: 900 }} 900w,
                         {{ product.featured_media | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 900px) 52vw, 100vw"
                 width="{{ product.featured_media.width }}"
                 height="{{ product.featured_media.height }}"
                 alt="{{ product.featured_media.alt | default: product.title | escape }}">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="galerie__vignettes">
            {%- for media in product.media -%}
              <button type="button"
                      data-image-vignette="{{ media | image_url: width: 1400 }}"
                      aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                      aria-label="Voir l'image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 220 }}" loading="lazy"
                     width="{{ media.width }}" height="{{ media.height }}"
                     alt="Aperçu {{ forloop.index }} de {{ product.title | escape }}">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        ---------- Colonne d'informations ----------
        Chaque élément est un bloc : l'ordre, la présence et les réglages se
        modifient depuis Personnaliser, sans toucher au code.

        Le formulaire enveloppe toute la colonne pour que le sélecteur de
        variantes, la quantité et le bouton d'achat restent solidaires quel
        que soit l'ordre choisi.
      {%- endcomment -%}
      <div class="fiche__info">
        {%- form 'product', product, id: 'form-produit' -%}
          <input type="hidden" name="id" id="variante-id" value="{{ v.id }}">

          {%- comment -%}
            Si le gabarit ne déclare aucun bloc, la disposition par défaut
            s'affiche : la page reste complète et identique.
          {%- endcomment -%}
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {% render 'bloc-produit',
                 type: block.type, block: block, product: product,
                 v: v, note: note, nb_avis: nb_avis, form: form %}
            {%- endfor -%}
          {%- else -%}
            {%- assign disposition = 'marque,titre,accroche,note,prix,options,stock,achat,actions,points_forts,services' | split: ',' -%}
            {%- for type_bloc in disposition -%}
              {% render 'bloc-produit',
                 type: type_bloc, product: product,
                 v: v, note: note, nb_avis: nb_avis, form: form %}
            {%- endfor -%}
          {%- endif -%}

        {%- endform -%}
      </div>
    </div>

    {%- comment -%} Données de variantes lues par assets/theme.js. {%- endcomment -%}
    <script type="application/json" id="donnees-produit">
      {{ product | json }}
    </script>
  </div>

  {%- comment -%} ---------- Onglets sous la fiche ---------- {%- endcomment -%}
  {%- if section.settings.afficher_onglets -%}
    {%- assign specs = product.metafields.custom.caracteristiques.value -%}
    <div class="onglets" role="tablist">
      <button role="tab" aria-selected="true" aria-controls="panneau-desc" id="tab-desc">
        {{ section.settings.titre_onglet_desc }}
      </button>
      {%- if specs != blank -%}
        <button role="tab" aria-selected="false" aria-controls="panneau-specs" id="tab-specs">
          {{ section.settings.titre_onglet_specs }}
        </button>
      {%- endif -%}
      {%- if section.settings.texte_livraison != blank -%}
        <button role="tab" aria-selected="false" aria-controls="panneau-livraison" id="tab-livraison">
          {{ section.settings.titre_onglet_livraison }}
        </button>
      {%- endif -%}
    </div>

    <div class="panneau" id="panneau-desc" role="tabpanel" aria-labelledby="tab-desc">
      <div class="prose">{{ product.description | default: '<p>Aucune description pour ce produit.</p>' }}</div>
    </div>

    {%- if specs != blank -%}
      <div class="panneau" id="panneau-specs" role="tabpanel" aria-labelledby="tab-specs" hidden>
        <table class="tableau-specs"><tbody>
          {%- for ligne in specs -%}
            {%- assign paire = ligne | split: ' : ' -%}
            <tr><th scope="row">{{ paire[0] }}</th><td>{{ paire[1] | default: '—' }}</td></tr>
          {%- endfor -%}
        </tbody></table>
      </div>
    {%- endif -%}

    {%- if section.settings.texte_livraison != blank -%}
      <div class="panneau" id="panneau-livraison" role="tabpanel" aria-labelledby="tab-livraison" hidden>
        <div class="prose">{{ section.settings.texte_livraison }}</div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{%- comment -%} ---------- Produits liés ---------- {%- endcomment -%}
{%- if section.settings.afficher_lies -%}
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{{ section.settings.surtitre_lies }}</p>
          <h2>{{ section.settings.titre_lies }}</h2>
        </div>
        <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">Tout le catalogue</a>
      </div>

      <div class="grille-produits">
        {%- assign lies = collections[product.collections.first.handle].products | default: collections.all.products -%}
        {%- assign compte = 0 -%}
        {%- for autre in lies -%}
          {%- if autre.id != product.id and compte < section.settings.nombre_lies -%}
            {% render 'product-card', product: autre %}
            {%- assign compte = compte | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

