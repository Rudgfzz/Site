<section class="section{% if section.settings.fond_alterne %} section--alt{% endif %}">
  <div class="container split">
    <div>
      {%- if section.settings.surtitre != blank -%}<p class="eyebrow">{{ section.settings.surtitre }}</p>{%- endif -%}
      <h2>{{ section.settings.titre }}</h2>
      {%- if section.settings.texte != blank -%}<div class="lead">{{ section.settings.texte }}</div>{%- endif -%}
      {%- if section.settings.bouton_texte != blank -%}
        <div class="btn-row">
          <a class="btn btn--ghost" href="{{ section.settings.bouton_lien }}">{{ section.settings.bouton_texte }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cartes-info">
        {%- for block in section.blocks -%}
          <div class="carte-info reveal" {{ block.shopify_attributes }}>
            {% render 'icon', nom: block.settings.icone %}
            <h3>{{ block.settings.titre }}</h3>
            <p>{{ block.settings.texte }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div>
        {%- if section.settings.image -%}
          {%- assign alt_img = section.settings.image.alt | default: section.settings.titre -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy',
             widths: '600, 900, 1200', sizes: '(min-width: 860px) 45vw, 100vw', alt: alt_img }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texte et arguments",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Notre méthode" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "On refuse plus de produits qu'on n'en vend." },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>Chaque référence passe deux semaines entre nos mains avant d'être mise en vente.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Utilisée si aucun argument n'est ajouté." },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond alterné", "default": true },
    { "type": "text", "id": "bouton_texte", "label": "Texte du bouton" },
    { "type": "url", "id": "bouton_lien", "label": "Lien du bouton" }
  ],
  "blocks": [
    {
      "type": "argument",
      "name": "Argument",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Icône",
          "options": [
            { "value": "etincelle", "label": "Nouveauté" },
            { "value": "bouclier", "label": "Garantie" },
            { "value": "colis", "label": "Colis" },
            { "value": "casque", "label": "Conseil" },
            { "value": "retour", "label": "Retour" },
            { "value": "camion", "label": "Livraison" }
          ],
          "default": "etincelle"
        },
        { "type": "text", "id": "titre", "label": "Titre", "default": "Testé deux semaines" },
        { "type": "text", "id": "texte", "label": "Texte", "default": "En usage réel, pas sur fiche technique." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texte et arguments",
      "blocks": [{ "type": "argument" }, { "type": "argument" }, { "type": "argument" }, { "type": "argument" }]
    }
  ]
}
{% endschema %}
