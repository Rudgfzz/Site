{%- assign p = section.settings.produit -%}
<section class="section">
  <div class="container">
    <div class="promo">
      <div>
        {%- if section.settings.surtitre != blank -%}<p class="eyebrow">{{ section.settings.surtitre }}</p>{%- endif -%}
        <h2>{{ p.title | default: section.settings.titre }}</h2>

        {%- if section.settings.texte != blank -%}
          <div class="lead">{{ section.settings.texte }}</div>
        {%- endif -%}

        {%- if section.settings.afficher_rebours -%}
          <div class="compte-rebours" id="compte-rebours" aria-live="off"
               data-fin="{{ section.settings.fin_offre }}"></div>
        {%- endif -%}

        <div class="btn-row">
          <a class="btn btn--lg" href="{{ p.url | default: routes.all_products_collection_url }}">
            {{ section.settings.bouton | default: "Profiter de l'offre" }}
          </a>
        </div>
      </div>

      <div>
        {%- if p != blank and p.featured_media -%}
          {{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: p.title }}
        {%- elsif section.settings.image -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.titre }}
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offre en avant",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Offre de la semaine" },
    { "type": "product", "id": "produit", "label": "Produit mis en avant" },
    { "type": "text", "id": "titre", "label": "Titre de repli", "default": "Offre en cours" },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>Offre valable dans la limite des stocks disponibles.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image de repli" },
    { "type": "text", "id": "bouton", "label": "Texte du bouton", "default": "Profiter de l'offre" },
    { "type": "checkbox", "id": "afficher_rebours", "label": "Afficher un compte à rebours", "default": true },
    {
      "type": "text",
      "id": "fin_offre",
      "label": "Fin de l'offre",
      "info": "Format AAAA-MM-JJTHH:MM. Vide = dimanche prochain à minuit.",
      "placeholder": "2026-12-31T23:59"
    }
  ],
  "presets": [{ "name": "Offre en avant" }]
}
{% endschema %}
