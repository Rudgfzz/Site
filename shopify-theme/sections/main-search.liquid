<div class="container">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>{{ section.settings.titre }}
  </nav>
</div>

<section class="section" style="padding-top:26px">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.surtitre != blank -%}<p class="eyebrow">{{ section.settings.surtitre }}</p>{%- endif -%}
        <h1 style="font-size:clamp(1.7rem,3.4vw,2.4rem)">
          {%- if search.performed -%}
            {{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %}
          {%- else -%}
            {{ section.settings.titre }}
          {%- endif -%}
        </h1>
      </div>
    </div>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="sr-only" for="q">Rechercher</label>
      <input class="input" id="q" type="search" name="q" value="{{ search.terms | escape }}"
             placeholder="{{ section.settings.placeholder }}" autocomplete="off">
      <button class="btn" type="submit">{{ section.settings.bouton }}</button>
    </form>

    {%- if search.performed -%}
      {% paginate search.results by section.settings.par_page %}
        <div class="grille-produits" id="grille-boutique" data-vue="grille">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- else -%}
            <div class="vide">
              <h3>{{ section.settings.titre_vide }}</h3>
              <p>{{ section.settings.texte_vide }}</p>
              <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">Voir tout le catalogue</a>
            </div>
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Recherche",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Recherche" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Que cherchez-vous ?" },
    { "type": "text", "id": "placeholder", "label": "Texte du champ", "default": "Rechercher un produit…" },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Rechercher" },
    { "type": "range", "id": "par_page", "min": 8, "max": 48, "step": 4, "label": "Résultats par page", "default": 12 },
    { "type": "text", "id": "titre_vide", "label": "Titre si aucun résultat", "default": "Aucun résultat" },
    { "type": "text", "id": "texte_vide", "label": "Texte si aucun résultat", "default": "Essayez avec un autre mot, ou parcourez le catalogue." }
  ]
}
{% endschema %}
