<div class="container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>Recherche
  </nav>
</div>

<section class="section" style="padding-top:32px">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Recherche</p>
        <h1 style="font-size:clamp(1.6rem,3.4vw,2.3rem)">
          {%- if search.performed -%}
            {{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %}
          {%- else -%}
            Que cherchez-vous ?
          {%- endif -%}
        </h1>
      </div>
    </div>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="sr-only" for="q">Rechercher</label>
      <input class="input" id="q" type="search" name="q" value="{{ search.terms | escape }}"
             placeholder="Rechercher un produit…" autocomplete="off">
      <button class="btn" type="submit">Rechercher</button>
    </form>

    {%- if search.performed -%}
      {% paginate search.results by 12 %}
        <div class="grid-products">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- else -%}
            <p class="empty-state">Aucun résultat pour « {{ search.terms }} ».</p>
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Recherche",
  "settings": []
}
{% endschema %}
