<section class="section{% if section.settings.fond_alterne %} section--soft{% endif %}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.surtitre != blank -%}
          <p class="eyebrow">{{ section.settings.surtitre }}</p>
        {%- endif -%}
        <h2>{{ section.settings.titre }}</h2>
      </div>
    </div>

    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- if col != blank -%}
          <a class="cat-card" href="{{ col.url }}" {{ block.shopify_attributes }}>
            {{ col.title }}
            <span>{{ col.products_count }} produit{% if col.products_count > 1 %}s{% endif %}</span>
          </a>
        {%- endif -%}
      {%- else -%}
        <p class="empty-state">Ajoutez des collections dans les réglages de cette section.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liste de catégories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Catalogue" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Par catégorie" },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond gris clair", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Catégorie",
      "limit": 8,
      "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }]
    }
  ],
  "presets": [
    {
      "name": "Liste de catégories",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
