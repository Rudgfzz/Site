{%- comment -%}
  Section libre, ajoutable sur n'importe quelle page depuis l'éditeur.
{%- endcomment -%}
<section class="section{% if section.settings.fond_alterne %} section--alt{% endif %}"
         {% if section.settings.ancre != blank %}id="{{ section.settings.ancre }}"{% endif %}>
  <div class="container{% if section.settings.largeur == 'etroite' %} container--narrow{% endif %}">
    <div class="{% if section.settings.centrer %}section-head section-head--center{% else %}section-head{% endif %}"
         style="margin-bottom:26px">
      <div>
        {%- if section.settings.surtitre != blank -%}
          <p class="eyebrow{% if section.settings.centrer %} eyebrow--plain{% endif %}">{{ section.settings.surtitre }}</p>
        {%- endif -%}
        {%- if section.settings.titre != blank -%}<h2>{{ section.settings.titre }}</h2>{%- endif -%}
      </div>
    </div>

    {%- if section.settings.texte != blank -%}
      <div class="prose{% if section.settings.centrer %} text-center{% endif %}"
           {% if section.settings.centrer %}style="margin-inline:auto"{% endif %}>
        {{ section.settings.texte }}
      </div>
    {%- endif -%}

    {%- if section.settings.bouton != blank -%}
      <div class="btn-row" {% if section.settings.centrer %}style="justify-content:center"{% endif %}>
        <a class="btn btn--{{ section.settings.style_bouton }}" href="{{ section.settings.lien }}">
          {{ section.settings.bouton }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texte enrichi",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Un titre de section" },
    { "type": "richtext", "id": "texte", "label": "Texte", "default": "<p>Votre texte ici.</p>" },
    { "type": "checkbox", "id": "centrer", "label": "Centrer", "default": false },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond alterné", "default": false },
    {
      "type": "select", "id": "largeur", "label": "Largeur", "default": "normale",
      "options": [
        { "value": "normale", "label": "Normale" },
        { "value": "etroite", "label": "Étroite" }
      ]
    },
    { "type": "text", "id": "ancre", "label": "Ancre", "info": "Permet un lien direct vers cette section." },
    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "bouton", "label": "Texte du bouton" },
    { "type": "url", "id": "lien", "label": "Lien" },
    {
      "type": "select", "id": "style_bouton", "label": "Style", "default": "ghost",
      "options": [
        { "value": "ghost", "label": "Contour" },
        { "value": "soft", "label": "Discret" },
        { "value": "lg", "label": "Principal" }
      ]
    }
  ],
  "presets": [{ "name": "Texte enrichi" }]
}
{% endschema %}
