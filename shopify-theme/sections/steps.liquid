<section class="section{% if section.settings.fond_alterne %} section--soft{% endif %}"
         {% if section.settings.ancre != blank %}id="{{ section.settings.ancre }}"{% endif %}>
  <div class="container">
    <div class="section-head text-center" style="display:block;text-align:center">
      {%- if section.settings.surtitre != blank -%}
        <p class="eyebrow">{{ section.settings.surtitre }}</p>
      {%- endif -%}
      <h2>{{ section.settings.titre }}</h2>
    </div>

    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.titre }}</h3>
          <p>{{ block.settings.texte }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Étapes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "En trois étapes" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "De l'achat à la première retouche" },
    {
      "type": "text",
      "id": "ancre",
      "label": "Ancre",
      "info": "Permet un lien direct vers cette section, par exemple « comment ».",
      "default": "comment"
    },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond gris clair", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre", "default": "Choisissez votre pack" },
        {
          "type": "text",
          "id": "texte",
          "label": "Texte",
          "default": "Parcourez le catalogue et ajoutez au panier ce qui vous parle."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Étapes",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
