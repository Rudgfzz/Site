<div class="container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>
    <a href="{{ blog.url }}">{{ blog.title }}</a><span>/</span>{{ article.title | truncate: 40 }}
  </nav>
</div>

<article class="section" style="padding-top:36px">
  <div class="container">
    <div class="article-body">
      <p class="eyebrow">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%d %B %Y' }}
        </time>
        {%- if article.author != blank %} · {{ article.author }}{% endif -%}
      </p>

      <h1 style="font-size:clamp(1.8rem,3.8vw,2.6rem)">{{ article.title }}</h1>

      {%- if article.image -%}
        <img src="{{ article.image | image_url: width: 1400 }}"
             alt="{{ article.image.alt | default: article.title | escape }}"
             width="1400" height="875">
      {%- endif -%}

      <div class="prose" style="max-width:none">{{ article.content }}</div>

      <p style="margin-top:36px">
        <a class="btn btn--ghost" href="{{ blog.url }}">← Tous les articles</a>
      </p>
    </div>
  </div>
</article>

{%- if blog.comments_enabled? -%}
  <section class="section section--soft">
    <div class="container">
      <div class="article-body">
        <h2 style="font-size:1.2rem">
          {{ article.comments_count }} commentaire{% if article.comments_count > 1 %}s{% endif %}
        </h2>

        {%- for comment in article.comments -%}
          <blockquote class="quote" style="margin-bottom:16px">
            <p>{{ comment.content }}</p>
            <footer>{{ comment.author }} · {{ comment.created_at | date: '%d/%m/%Y' }}</footer>
          </blockquote>
        {%- endfor -%}

        {%- form 'new_comment', article -%}
          {%- if form.posted_successfully? -%}
            <div class="alert alert--ok">Merci, votre commentaire a bien été envoyé.</div>
          {%- elsif form.errors -%}
            <div class="alert alert--error">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="field">
            <label for="commentaire-auteur">Votre nom</label>
            <input class="input" id="commentaire-auteur" type="text" name="comment[author]"
                   value="{{ form.author }}" required>
          </div>
          <div class="field">
            <label for="commentaire-email">Votre e-mail</label>
            <input class="input" id="commentaire-email" type="email" name="comment[email]"
                   value="{{ form.email }}" required>
          </div>
          <div class="field">
            <label for="commentaire-corps">Votre commentaire</label>
            <textarea class="textarea" id="commentaire-corps" name="comment[body]" required>{{ form.body }}</textarea>
          </div>
          <button class="btn" type="submit">Publier</button>
        {%- endform -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
