<div class="container">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>
    <a href="{{ blog.url }}">{{ blog.title }}</a><span>/</span>{{ article.title | truncate: 40 }}
  </nav>
</div>

<article class="section" style="padding-top:26px">
  <div class="container">
    <div class="article-body">
      <p class="eyebrow eyebrow--plain">
        {%- if section.settings.afficher_date -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{ article.published_at | date: '%d %B %Y' }}
          </time>
        {%- endif -%}
        {%- if section.settings.afficher_auteur and article.author != blank %} · {{ article.author }}{% endif -%}
      </p>

      <h1 style="font-size:clamp(1.8rem,3.8vw,2.6rem)">{{ article.title }}</h1>

      {%- if article.image and section.settings.afficher_image -%}
        <img src="{{ article.image | image_url: width: 1400 }}"
             alt="{{ article.image.alt | default: article.title | escape }}"
             width="1400" height="875">
      {%- endif -%}

      <div class="prose" style="max-width:none">{{ article.content }}</div>

      <p style="margin-top:36px">
        <a class="btn btn--ghost" href="{{ blog.url }}">← {{ section.settings.retour }}</a>
      </p>
    </div>
  </div>
</article>

{%- if blog.comments_enabled? -%}
  <section class="section section--alt">
    <div class="container">
      <div class="article-body">
        <h2 style="font-size:1.2rem">
          {{ article.comments_count }} commentaire{% if article.comments_count > 1 %}s{% endif %}
        </h2>

        {%- for comment in article.comments -%}
          <div class="avis-card" style="margin-bottom:16px">
            <p>{{ comment.content }}</p>
            <footer><span class="avatar">{{ comment.author | slice: 0, 1 | upcase }}</span>
              {{ comment.author }} · {{ comment.created_at | date: '%d/%m/%Y' }}</footer>
          </div>
        {%- endfor -%}

        {%- form 'new_comment', article -%}
          {%- if form.posted_successfully? -%}
            <div class="alerte alerte--ok">Merci, votre commentaire a bien été envoyé.</div>
          {%- elsif form.errors -%}
            <div class="alerte alerte--err">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="field">
            <label for="commentaire-auteur">Votre nom</label>
            <input class="input" id="commentaire-auteur" name="comment[author]" value="{{ form.author }}" required>
          </div>
          <div class="field">
            <label for="commentaire-email">Votre e-mail</label>
            <input class="input" id="commentaire-email" type="email" name="comment[email]" value="{{ form.email }}" required>
          </div>
          <div class="field">
            <label for="commentaire-corps">Votre commentaire</label>
            <textarea class="textarea" id="commentaire-corps" name="comment[body]" required>{{ form.body }}</textarea>
          </div>
          <button class="btn" type="submit">Publier</button>
        {%- endform -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "afficher_date", "label": "Afficher la date", "default": true },
    { "type": "checkbox", "id": "afficher_auteur", "label": "Afficher l'auteur", "default": true },
    { "type": "checkbox", "id": "afficher_image", "label": "Afficher l'image d'en-tête", "default": true },
    { "type": "text", "id": "retour", "label": "Lien de retour", "default": "Tous les articles" }
  ]
}
{% endschema %}
