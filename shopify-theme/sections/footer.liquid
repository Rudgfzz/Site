<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__marque">
        <a class="logo" href="{{ routes.root_url }}">
          <span class="logo__mark">{% render 'icon', nom: 'logo' %}</span>
          {{ shop.name }}
        </a>
        {%- if section.settings.baseline != blank -%}
          <p>{{ section.settings.baseline }}</p>
        {%- endif -%}
        {%- if section.settings.afficher_reseaux -%}
        <div class="reseaux">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              {% render 'icon', nom: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
              {% render 'icon', nom: 'youtube' %}</a>
          {%- endif -%}
          {%- if settings.social_x != blank -%}
            <a href="{{ settings.social_x }}" aria-label="X" target="_blank" rel="noopener">
              {% render 'icon', nom: 'x' %}</a>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.titre }}</h4>
          <ul>
            {%- for lien in block.settings.menu.links -%}
              <li><a href="{{ lien.url }}">{{ lien.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bas">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}</p>
      {%- if section.settings.mention != blank -%}
        <p>{{ section.settings.mention }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "text",
      "id": "baseline",
      "label": "Phrase de présentation",
      "default": "L'écosystème mobile, sans compromis. Sélection resserrée, conseils honnêtes."
    },
    {
      "type": "text",
      "id": "mention",
      "label": "Mention de droite",
      "default": "Paiement sécurisé · CB · Visa · Mastercard · PayPal"
    },
    { "type": "checkbox", "id": "afficher_reseaux", "label": "Afficher les réseaux sociaux", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "titre": "Boutique" } },
      { "type": "menu", "settings": { "titre": "Aide" } },
      { "type": "menu", "settings": { "titre": "Société" } }
    ]
  }
}
{% endschema %}
