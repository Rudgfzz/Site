{%- comment -%}
  Parcours d'achat expliqué en quelques étapes numérotées.
  Chaque étape est un bloc : on en ajoute, on en retire, on les réordonne
  par glisser-déposer dans l'éditeur.
{%- endcomment -%}

<section class="section{% if section.settings.fond_alterne %} section--alt{% endif %}">
  <div class="container">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.surtitre != blank -%}
          <p class="eyebrow eyebrow--plain">{{ section.settings.surtitre }}</p>
        {%- endif -%}
        <h2>{{ section.settings.titre }}</h2>
        {%- if section.settings.texte != blank -%}
          <p>{{ section.settings.texte }}</p>
        {%- endif -%}
      </div>
    </div>

    <ol class="etapes">
      {%- for block in section.blocks -%}
        <li class="etape" {{ block.shopify_attributes }}>
          {%- if section.settings.afficher_numeros -%}
            <span class="etape__num" aria-hidden="true">{{ forloop.index }}</span>
          {%- endif -%}
          {%- if block.settings.icone != 'aucune' -%}
            <span class="etape__icone">{% render 'icon', nom: block.settings.icone %}</span>
          {%- endif -%}
          <h3>{{ block.settings.titre }}</h3>
          {%- if block.settings.texte != blank -%}
            <p>{{ block.settings.texte }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.lien_texte != blank -%}
      <div class="btn-row" style="justify-content:center;margin-top:38px">
        <a class="btn btn--ghost" href="{{ section.settings.lien }}">{{ section.settings.lien_texte }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comment ça marche",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "En pratique" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Commander en trois étapes" },
    {
      "type": "text",
      "id": "texte",
      "label": "Texte d'introduction",
      "default": "De la sélection de la taille à la réception du colis."
    },
    { "type": "checkbox", "id": "afficher_numeros", "label": "Afficher les numéros", "default": true },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond alterné", "default": false },
    { "type": "text", "id": "lien_texte", "label": "Texte du lien" },
    { "type": "url", "id": "lien", "label": "Lien" }
  ],
  "blocks": [
    {
      "type": "etape",
      "name": "Étape",
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Icône",
          "options": [
            { "value": "aucune", "label": "Aucune" },
            { "value": "loupe", "label": "Recherche" },
            { "value": "regle", "label": "Mesures" },
            { "value": "panier", "label": "Panier" },
            { "value": "carte", "label": "Paiement" },
            { "value": "colis", "label": "Colis" },
            { "value": "camion", "label": "Livraison" },
            { "value": "retour", "label": "Retour" },
            { "value": "coeur", "label": "Coup de cœur" },
            { "value": "etincelle", "label": "Nouveauté" }
          ],
          "default": "loupe"
        },
        { "type": "text", "id": "titre", "label": "Titre", "default": "Choisissez votre pièce" },
        {
          "type": "textarea",
          "id": "texte",
          "label": "Texte",
          "default": "Parcourez les catégories et repérez le modèle qui vous plaît."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comment ça marche",
      "blocks": [{ "type": "etape" }, { "type": "etape" }, { "type": "etape" }]
    }
  ]
}
{% endschema %}
