<div class="container">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>{{ page.title }}
  </nav>
</div>

<section class="section" style="padding-top:26px">
  <div class="container{% if section.settings.largeur == 'etroite' %} container--narrow{% endif %}">
    <div {% if section.settings.largeur == 'prose' %}class="prose"{% endif %}>
      {%- if section.settings.surtitre != blank -%}
        <p class="eyebrow">{{ section.settings.surtitre }}</p>
      {%- endif -%}
      {%- if section.settings.afficher_titre -%}
        <h1 style="font-size:clamp(1.8rem,3.6vw,2.5rem)">{{ page.title }}</h1>
      {%- endif -%}
      <div class="prose" style="max-width:none">{{ page.content }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre" },
    { "type": "checkbox", "id": "afficher_titre", "label": "Afficher le titre de la page", "default": true },
    {
      "type": "select",
      "id": "largeur",
      "label": "Largeur du contenu",
      "options": [
        { "value": "prose", "label": "Colonne de lecture" },
        { "value": "etroite", "label": "Étroite" },
        { "value": "large", "label": "Pleine largeur" }
      ],
      "default": "prose"
    }
  ]
}
{% endschema %}
