{%- comment -%}
  Guide des tailles.

  Le tableau se remplit sans toucher au code : une ligne d'en-têtes dans
  les réglages de la section, puis un bloc par ligne du tableau. Les
  cellules sont séparées par des points-virgules, ce qui laisse les
  virgules disponibles pour les décimales.
{%- endcomment -%}

{%- assign entetes = section.settings.colonnes | split: ';' -%}

<section class="section{% if section.settings.fond_alterne %} section--alt{% endif %}">
  <div class="container container--narrow">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.surtitre != blank -%}
          <p class="eyebrow eyebrow--plain">{{ section.settings.surtitre }}</p>
        {%- endif -%}
        <h2>{{ section.settings.titre }}</h2>
        {%- if section.settings.texte != blank -%}
          <p>{{ section.settings.texte }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="tableau-tailles__cadre">
        <table class="tableau-tailles">
          {%- if entetes.size > 0 -%}
            <thead>
              <tr>
                {%- for entete in entetes -%}
                  <th scope="col">{{ entete | strip }}</th>
                {%- endfor -%}
              </tr>
            </thead>
          {%- endif -%}
          <tbody>
            {%- for block in section.blocks -%}
              {%- assign cellules = block.settings.valeurs | split: ';' -%}
              <tr {{ block.shopify_attributes }}>
                {%- for cellule in cellules -%}
                  {%- if forloop.first -%}
                    <th scope="row">{{ cellule | strip }}</th>
                  {%- else -%}
                    <td>{{ cellule | strip }}</td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="prose" style="margin-top:26px">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Guide des tailles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Guide des tailles" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Trouvez votre taille du premier coup" },
    {
      "type": "text",
      "id": "texte",
      "label": "Texte d'introduction",
      "default": "Mesures prises à plat, sur le vêtement. En cas d'hésitation entre deux tailles, prenez la plus grande."
    },
    {
      "type": "text",
      "id": "colonnes",
      "label": "En-têtes des colonnes",
      "info": "Séparez les colonnes par des points-virgules.",
      "default": "Taille; Poitrine (cm); Longueur (cm); Épaules (cm)"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note sous le tableau",
      "default": "<p>Une tolérance de 1 à 2 cm est normale d'un article à l'autre. Le retour est gratuit sous 14 jours si la taille ne convient pas.</p>"
    },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond alterné", "default": false }
  ],
  "blocks": [
    {
      "type": "ligne",
      "name": "Ligne du tableau",
      "settings": [
        {
          "type": "text",
          "id": "valeurs",
          "label": "Cellules",
          "info": "Séparez les cellules par des points-virgules, dans l'ordre des colonnes.",
          "default": "S; 96; 68; 43"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide des tailles",
      "blocks": [
        { "type": "ligne" },
        { "type": "ligne" },
        { "type": "ligne" },
        { "type": "ligne" }
      ]
    }
  ]
}
{% endschema %}
