<div class="container">
  <div class="bandeau-confiance">
    {%- for block in section.blocks -%}
      <div class="confiance" {{ block.shopify_attributes }}>
        {% render 'icon', nom: block.settings.icone %}
        <span>
          <strong>{{ block.settings.titre }}</strong>
          <span>{{ block.settings.texte }}</span>
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bandeau de réassurance",
  "tag": "section",
  "blocks": [
    {
      "type": "argument",
      "name": "Argument",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Icône",
          "options": [
            { "value": "camion", "label": "Livraison" },
            { "value": "retour", "label": "Retour" },
            { "value": "bouclier", "label": "Garantie" },
            { "value": "casque", "label": "Conseil" },
            { "value": "etincelle", "label": "Nouveauté" },
            { "value": "colis", "label": "Colis" }
          ],
          "default": "camion"
        },
        { "type": "text", "id": "titre", "label": "Titre", "default": "Expédition sous 24 h" },
        { "type": "text", "id": "texte", "label": "Texte", "default": "Depuis notre entrepôt en France" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau de réassurance",
      "blocks": [
        { "type": "argument", "settings": { "icone": "camion" } },
        { "type": "argument", "settings": { "icone": "retour" } },
        { "type": "argument", "settings": { "icone": "bouclier" } },
        { "type": "argument", "settings": { "icone": "casque" } }
      ]
    }
  ]
}
{% endschema %}
