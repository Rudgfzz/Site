<div class="container">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>{{ page.title | default: 'Contact' }}
  </nav>
</div>

<section class="section" style="padding-top:26px">
  <div class="container">
    <div style="max-width:640px;margin-bottom:40px">
      {%- if section.settings.surtitre != blank -%}<p class="eyebrow">{{ section.settings.surtitre }}</p>{%- endif -%}
      <h1>{{ page.title | default: section.settings.titre }}</h1>
      {%- if page.content != blank -%}
        <div class="lead">{{ page.content }}</div>
      {%- elsif section.settings.texte != blank -%}
        <div class="lead">{{ section.settings.texte }}</div>
      {%- endif -%}
    </div>

    <div class="boutique" style="grid-template-columns:1fr 320px">
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <div class="alerte alerte--ok">{{ section.settings.confirmation }}</div>
        {%- elsif form.errors -%}
          <div class="alerte alerte--err">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="field field--half">
          <div>
            <label for="c-prenom">Prénom</label>
            <input class="input" id="c-prenom" name="contact[Prénom]" autocomplete="given-name" required>
          </div>
          <div>
            <label for="c-nom">Nom</label>
            <input class="input" id="c-nom" name="contact[name]" autocomplete="family-name" required>
          </div>
        </div>
        <div class="field">
          <label for="c-email">Adresse e-mail</label>
          <input class="input" id="c-email" name="contact[email]" type="email"
                 autocomplete="email" value="{{ form.email }}" required>
        </div>
        {%- if section.settings.sujets != blank -%}
          <div class="field">
            <label for="c-sujet">Sujet</label>
            <select class="select" id="c-sujet" name="contact[Sujet]">
              {%- assign liste = section.settings.sujets | split: ',' -%}
              {%- for sujet in liste -%}
                <option value="{{ sujet | strip | escape }}">{{ sujet | strip }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
        {%- if section.settings.champ_commande -%}
          <div class="field">
            <label for="c-commande">Numéro de commande <span class="form-note">(facultatif)</span></label>
            <input class="input" id="c-commande" name="contact[Commande]" placeholder="#1001">
          </div>
        {%- endif -%}
        <div class="field">
          <label for="c-message">Votre message</label>
          <textarea class="textarea" id="c-message" name="contact[body]" required>{{ form.body }}</textarea>
        </div>

        <div class="btn-row">
          <button class="btn btn--lg" type="submit">{{ section.settings.bouton }}</button>
        </div>
        {%- if section.settings.mention != blank -%}
          <p class="form-note" style="margin-top:14px">{{ section.settings.mention }}</p>
        {%- endif -%}
      {%- endform -%}

      <aside>
        {%- for block in section.blocks -%}
          <div class="carte-info" {% unless forloop.first %}style="margin-top:16px"{% endunless %} {{ block.shopify_attributes }}>
            {% render 'icon', nom: block.settings.icone %}
            <h3>{{ block.settings.titre }}</h3>
            <div>{{ block.settings.texte }}</div>
            {%- if block.settings.bouton != blank -%}
              <a class="btn btn--soft btn--sm" href="{{ block.settings.lien }}" style="margin-top:12px">
                {{ block.settings.bouton }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Nous écrire" },
    { "type": "text", "id": "titre", "label": "Titre si la page n'en a pas", "default": "Une question ? On vous répond." },
    { "type": "richtext", "id": "texte", "label": "Texte d'introduction" },
    {
      "type": "text",
      "id": "sujets",
      "label": "Sujets proposés",
      "info": "Séparés par des virgules. Laissez vide pour masquer le champ.",
      "default": "Conseil avant achat, Suivi de commande, Retour ou remboursement, Garantie, Autre"
    },
    { "type": "checkbox", "id": "champ_commande", "label": "Champ « Numéro de commande »", "default": true },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Envoyer le message" },
    { "type": "text", "id": "confirmation", "label": "Message de confirmation", "default": "Message envoyé. Nous revenons vers vous sous 24 h ouvrées." },
    { "type": "text", "id": "mention", "label": "Mention sous le formulaire", "default": "Vos données servent uniquement à traiter votre demande." }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Encart d'information",
      "limit": 4,
      "settings": [
        {
          "type": "select", "id": "icone", "label": "Icône", "default": "casque",
          "options": [
            { "value": "casque", "label": "Téléphone" }, { "value": "carte", "label": "E-mail" },
            { "value": "colis", "label": "Colis" }, { "value": "camion", "label": "Livraison" },
            { "value": "retour", "label": "Retour" }, { "value": "bouclier", "label": "Garantie" }
          ]
        },
        { "type": "text", "id": "titre", "label": "Titre", "default": "Par téléphone" },
        { "type": "richtext", "id": "texte", "label": "Texte", "default": "<p>Du lundi au samedi, 9 h – 19 h.</p>" },
        { "type": "text", "id": "bouton", "label": "Bouton" },
        { "type": "url", "id": "lien", "label": "Lien du bouton" }
      ]
    }
  ],
  "default": { "blocks": [{ "type": "info" }] }
}
{% endschema %}
