<section class="section">
  <div class="container">
    <div class="newsletter-band">
      {%- if section.settings.surtitre != blank -%}
        <p class="eyebrow eyebrow--plain">{{ section.settings.surtitre }}</p>
      {%- endif -%}
      <h2>{{ section.settings.titre }}</h2>
      {%- if section.settings.texte != blank -%}
        <div class="lead" style="margin-inline:auto">{{ section.settings.texte }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sr-only" for="email-newsletter">Votre adresse e-mail</label>
        <input class="input" id="email-newsletter" type="email" name="contact[email]"
               placeholder="vous@exemple.fr" autocomplete="email" required value="{{ form.email }}">
        <button class="btn" type="submit">{{ section.settings.bouton }}</button>

        {%- if form.posted_successfully? -%}
          <div class="alerte alerte--ok" style="width:100%;margin-top:14px">{{ section.settings.confirmation }}</div>
        {%- elsif form.errors -%}
          <div class="alerte alerte--err" style="width:100%;margin-top:14px">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.mention != blank -%}
        <p class="form-note" style="margin-top:14px">{{ section.settings.mention }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Lettre d'information" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Les bons plans, une fois par mois" },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>Nouveautés testées, baisses de prix réelles et guides d'achat.</p>"
    },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Je m'inscris" },
    { "type": "text", "id": "confirmation", "label": "Confirmation", "default": "Merci ! Votre inscription est enregistrée." },
    { "type": "text", "id": "mention", "label": "Mention", "default": "Désinscription en un clic. Aucune adresse revendue." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
