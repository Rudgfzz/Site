<div class="container">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>{{ page.title | default: 'Favoris' }}
  </nav>

  <div class="section-head" style="padding-top:26px">
    <div>
      {%- if section.settings.surtitre != blank -%}<p class="eyebrow">{{ section.settings.surtitre }}</p>{%- endif -%}
      <h1 style="font-size:clamp(1.7rem,3.4vw,2.4rem)">{{ page.title | default: section.settings.titre }}</h1>
      <p id="compteur-favoris-page"></p>
    </div>
    <div class="btn-row" id="actions-favoris" hidden>
      <button class="btn btn--ghost" type="button" id="vider-favoris">{{ section.settings.bouton_vider }}</button>
    </div>
  </div>

  {%- if page.content != blank -%}<div class="prose">{{ page.content }}</div>{%- endif -%}

  <div class="grille-produits" id="grille-favoris" data-vue="grille" style="padding-bottom:70px"></div>
</div>

<script>
  (function () {
    var zone = document.getElementById('grille-favoris');
    var compteur = document.getElementById('compteur-favoris-page');
    var actions = document.getElementById('actions-favoris');

    function api() { return (window.ORBIT && window.ORBIT.api) || null; }

    function rendre() {
      var a = api();
      if (!a) { return; }
      var liste = a.favoris();

      if (!liste.length) {
        zone.innerHTML =
          '<div class="vide"><h3>{{ section.settings.titre_vide | escape }}</h3>' +
          '<p>{{ section.settings.texte_vide | escape }}</p>' +
          '<a class="btn" href="{{ routes.all_products_collection_url }}">Voir la boutique</a></div>';
        compteur.textContent = '';
        actions.hidden = true;
        return;
      }

      actions.hidden = false;
      compteur.textContent = liste.length + ' produit' + (liste.length > 1 ? 's' : '') + ' enregistré' + (liste.length > 1 ? 's' : '');
      zone.innerHTML = '<div class="squelette" style="height:340px"></div>'.repeat(Math.min(liste.length, 4));

      /* Chaque carte est rendue par Shopify, ce qui garantit un balisage
         identique à celui de la boutique. */
      Promise.all(liste.map(function (handle) {
        return fetch('/products/' + encodeURIComponent(handle) + '?section_id=carte-produit')
          .then(function (r) { return r.ok ? r.text() : ''; })
          .catch(function () { return ''; });
      })).then(function (fragments) {
        var html = fragments.filter(Boolean).join('');
        zone.innerHTML = html || '<div class="vide"><h3>Produits indisponibles</h3>' +
          '<p>Ces produits ne sont plus au catalogue.</p></div>';
        document.querySelectorAll('#grille-favoris [data-favori]').forEach(function (b) {
          b.setAttribute('aria-pressed', 'true');
        });
      });
    }

    document.addEventListener('favoris:maj', rendre);
    document.getElementById('vider-favoris').addEventListener('click', function () {
      var a = api();
      if (!a) return;
      a.ecrire('orbit_favoris', []);
      a.majCompteurs();
      rendre();
      a.notifier('Favoris vidés');
    });

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', rendre);
    else setTimeout(rendre, 0);
  })();
</script>

{% schema %}
{
  "name": "Page favoris",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Votre sélection" },
    { "type": "text", "id": "titre", "label": "Titre si la page n'en a pas", "default": "Mes favoris" },
    { "type": "text", "id": "bouton_vider", "label": "Bouton pour vider", "default": "Vider la liste" },
    { "type": "text", "id": "titre_vide", "label": "Titre si aucun favori", "default": "Aucun favori pour l'instant" },
    { "type": "text", "id": "texte_vide", "label": "Texte si aucun favori", "default": "Cliquez sur le cœur d'un produit pour l'enregistrer ici." }
  ]
}
{% endschema %}
