<section class="section{% if section.settings.fond_alterne %} section--alt{% endif %}">
  <div class="container">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.surtitre != blank -%}
          <p class="eyebrow eyebrow--plain">{{ section.settings.surtitre }}</p>
        {%- endif -%}
        <h2>{{ section.settings.titre }}</h2>
        {%- if section.settings.texte != blank -%}<p>{{ section.settings.texte }}</p>{%- endif -%}
      </div>
    </div>

    <div class="avis-grid">
      {%- for block in section.blocks -%}
        <article class="avis-card reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.etoiles > 0 -%}
            <p class="etoiles" aria-label="{{ block.settings.etoiles }} sur 5">
              {%- for i in (1..5) -%}{% if i <= block.settings.etoiles %}★{% else %}☆{% endif %}{%- endfor -%}
            </p>
          {%- endif -%}
          <p>{{ block.settings.texte }}</p>
          {%- if block.settings.auteur != blank -%}
            <footer>
              <span class="avatar">{{ block.settings.auteur | slice: 0, 1 | upcase }}</span>
              {{ block.settings.auteur }}
            </footer>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Avis clients" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Ils ont commandé chez nous" },
    { "type": "text", "id": "texte", "label": "Texte" },
    { "type": "checkbox", "id": "fond_alterne", "label": "Fond alterné", "default": false }
  ],
  "blocks": [
    {
      "type": "avis",
      "name": "Avis",
      "limit": 6,
      "settings": [
        { "type": "range", "id": "etoiles", "min": 0, "max": 5, "step": 1, "label": "Étoiles", "default": 5 },
        {
          "type": "textarea",
          "id": "texte",
          "label": "Avis",
          "info": "N'affichez que des avis réellement reçus : publier de faux avis est sanctionné.",
          "default": "À REMPLACER par un avis réellement reçu d'un client."
        },
        { "type": "text", "id": "auteur", "label": "Auteur", "default": "Prénom N. — Ville" }
      ]
    }
  ],
  "presets": [
    { "name": "Avis clients", "blocks": [{ "type": "avis" }, { "type": "avis" }, { "type": "avis" }] }
  ]
}
{% endschema %}
