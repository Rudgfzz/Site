<section class="hero">
  <div class="container hero__grid">
    <div>
      {%- if section.blocks.size > 0 -%}
        <div class="hero__puces">
          {%- for block in section.blocks -%}
            {%- if block.type == 'puce' -%}
              <span class="puce" {{ block.shopify_attributes }}>
                {% render 'icon', nom: block.settings.icone %} {{ block.settings.texte }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <h1>
        {{ section.settings.titre }}
        {%- if section.settings.titre_accent != blank %}
          <span class="grad-text">{{ section.settings.titre_accent }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.texte != blank -%}
        <div class="lead">{{ section.settings.texte }}</div>
      {%- endif -%}

      <div class="btn-row">
        {%- if section.settings.bouton_1_texte != blank -%}
          <a class="btn btn--lg" href="{{ section.settings.bouton_1_lien | default: routes.all_products_collection_url }}">
            {{ section.settings.bouton_1_texte }}
          </a>
        {%- endif -%}
        {%- if section.settings.bouton_2_texte != blank -%}
          <a class="btn btn--ghost btn--lg" href="{{ section.settings.bouton_2_lien }}">
            {{ section.settings.bouton_2_texte }}
          </a>
        {%- endif -%}
      </div>

      {%- assign stats = section.blocks | where: 'type', 'stat' -%}
      {%- if stats.size > 0 -%}
        <div class="hero__stats">
          {%- for block in stats -%}
            <div {{ block.shopify_attributes }}>
              <strong>{{ block.settings.chiffre }}</strong>
              <span>{{ block.settings.libelle }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero__media">
      {%- if section.settings.image -%}
        {%- assign alt_hero = section.settings.image.alt | default: section.settings.titre -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 900px) 45vw, 100vw',
            fetchpriority: 'high', alt: alt_hero
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bandeau d'accueil",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "titre", "label": "Titre", "default": "L'écosystème mobile," },
    {
      "type": "text",
      "id": "titre_accent",
      "label": "Fin du titre (en dégradé)",
      "default": "sans compromis."
    },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>Une sélection resserrée de smartphones, tablettes, montres et audio. Seulement les modèles que nous recommanderions à un proche.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "bouton_1_texte", "label": "Bouton principal", "default": "Découvrir la boutique" },
    { "type": "url", "id": "bouton_1_lien", "label": "Lien du bouton principal" },
    { "type": "text", "id": "bouton_2_texte", "label": "Bouton secondaire" },
    { "type": "url", "id": "bouton_2_lien", "label": "Lien du bouton secondaire" }
  ],
  "blocks": [
    {
      "type": "puce",
      "name": "Pastille",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Icône",
          "options": [
            { "value": "camion", "label": "Livraison" },
            { "value": "retour", "label": "Retour" },
            { "value": "bouclier", "label": "Garantie" },
            { "value": "etincelle", "label": "Nouveauté" }
          ],
          "default": "camion"
        },
        { "type": "text", "id": "texte", "label": "Texte", "default": "Livraison offerte dès 60 €" }
      ]
    },
    {
      "type": "stat",
      "name": "Chiffre clé",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "chiffre", "label": "Chiffre", "default": "24 h" },
        { "type": "text", "id": "libelle", "label": "Libellé", "default": "expédition" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau d'accueil",
      "blocks": [
        { "type": "puce" },
        { "type": "stat" }, { "type": "stat" }, { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
