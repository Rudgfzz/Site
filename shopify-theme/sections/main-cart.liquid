<div class="container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span>/</span>Panier
  </nav>

  <div style="padding:28px 0 26px">
    <h1 style="font-size:clamp(1.7rem,3.4vw,2.3rem)">Votre panier</h1>
    <p class="lead" style="margin:0">{{ section.settings.sous_titre }}</p>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state" style="margin:20px 0 60px">
      <h2 style="font-size:1.2rem;color:var(--text)">Votre panier est vide</h2>
      <p>Parcourez le catalogue pour y ajouter des produits.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Découvrir la boutique</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate id="form-panier">
      <div class="cart-layout">
        <div>
          {%- for item in cart.items -%}
            <div class="cart-line">
              <a class="cart-line__img" href="{{ item.url }}">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" loading="lazy"
                       width="200" height="150"
                       alt="{{ item.image.alt | default: item.product.title | escape }}">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>

              <div>
                <p class="cart-line__name"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
                <p class="cart-line__meta">
                  {%- unless item.product.has_only_default_variant -%}
                    {{ item.variant.title }} ·
                  {%- endunless -%}
                  {{ item.original_price | money }} l'unité
                </p>
                {%- if item.line_level_discount_allocations.size > 0 -%}
                  {%- for remise in item.line_level_discount_allocations -%}
                    <p class="cart-line__meta">{{ remise.discount_application.title }} (−{{ remise.amount | money }})</p>
                  {%- endfor -%}
                {%- endif -%}
              </div>

              <div class="cart-line__end">
                <div class="qty-input">
                  <button type="button" data-qty-moins aria-label="Diminuer la quantité">−</button>
                  <label class="sr-only" for="quantite-{{ forloop.index }}">
                    Quantité de {{ item.product.title | escape }}
                  </label>
                  <input id="quantite-{{ forloop.index }}" name="updates[]" data-cart-qty
                         type="number" value="{{ item.quantity }}" min="0" inputmode="numeric">
                  <button type="button" data-qty-plus aria-label="Augmenter la quantité">+</button>
                </div>

                <strong class="price">{{ item.final_line_price | money }}</strong>

                <a class="link-danger" href="{{ item.url_to_remove }}">Retirer</a>
              </div>
            </div>
          {%- endfor -%}

          {%- if section.settings.show_note -%}
            <div class="cart-note">
              <label for="note-commande">Instructions pour la commande</label>
              <textarea class="textarea" id="note-commande" name="note"
                        style="min-height:90px">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <noscript>
            <button class="btn btn--soft" type="submit" name="update" style="margin-top:20px">
              Mettre à jour le panier
            </button>
          </noscript>
        </div>

        <aside class="summary">
          <h2>Récapitulatif</h2>

          <div class="summary__row">
            <span>Sous-total</span><span>{{ cart.items_subtotal_price | money }}</span>
          </div>

          {%- for remise in cart.cart_level_discount_applications -%}
            <div class="summary__row">
              <span>{{ remise.title }}</span><span>−{{ remise.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}

          <div class="summary__row">
            <span>Livraison</span><span>{{ section.settings.mention_livraison }}</span>
          </div>

          <div class="summary__total">
            <span>Total</span><span>{{ cart.total_price | money_with_currency }}</span>
          </div>

          <button class="btn btn--block btn--lg" type="submit" name="checkout" style="margin-top:20px">
            Passer commande
          </button>

          <p class="form-note" style="margin-top:14px;text-align:center">
            Taxes et remises calculées au paiement.
          </p>
        </aside>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Panier",
  "settings": [
    {
      "type": "text",
      "id": "sous_titre",
      "label": "Phrase sous le titre",
      "default": "Les fichiers sont téléchargeables dès la commande validée."
    },
    {
      "type": "text",
      "id": "mention_livraison",
      "label": "Mention de livraison",
      "default": "Téléchargement — gratuit"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Autoriser une note de commande",
      "default": false
    }
  ]
}
{% endschema %}
