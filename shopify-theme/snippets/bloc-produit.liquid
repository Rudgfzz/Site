{%- comment -%}
  Un élément de la colonne d'informations de la page produit.

  Appelé de deux façons :
    • avec `block` : le bloc configuré dans l'éditeur ;
    • sans `block` : disposition par défaut, quand le gabarit n'en déclare
      aucun. La page reste alors complète et identique.

  Paramètres : type, product, v, note, nb_avis, form, block (facultatif)
{%- endcomment -%}

{%- case type -%}

  {%- when 'marque' -%}
    <p class="eyebrow" {{ block.shopify_attributes }}>
      {{ product.vendor }}{% if product.type != blank %} · {{ product.type }}{% endif %}
    </p>

  {%- when 'titre' -%}
    <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>

  {%- when 'accroche' -%}
    {%- assign texte = product.metafields.custom.accroche | default: block.settings.texte_secours -%}
    {%- if texte != blank -%}
      <p class="lead" style="font-size:1.03rem" {{ block.shopify_attributes }}>{{ texte }}</p>
    {%- endif -%}

  {%- when 'note' -%}
    {%- if note -%}
      {%- assign pleines = note | round -%}
      <p class="note" style="margin-bottom:16px" {{ block.shopify_attributes }}>
        <span class="etoiles" aria-hidden="true">
          {%- for i in (1..5) -%}{% if i <= pleines %}★{% else %}☆{% endif %}{%- endfor -%}
        </span>
        <span>{{ note | round: 1 }} sur 5{% if nb_avis %} · {{ nb_avis }} avis{% endif %}</span>
      </p>
    {%- endif -%}

  {%- when 'prix' -%}
    <div {{ block.shopify_attributes }}>
      <div class="fiche__prix">
        <span class="montant" id="prix-affiche">{{ v.price | money }}</span>
        <s id="prix-barre" {% unless v.compare_at_price > v.price %}hidden{% endunless %}>
          {{ v.compare_at_price | money }}
        </s>
        <span class="remise" id="remise" {% unless v.compare_at_price > v.price %}hidden{% endunless %}>
          {%- if v.compare_at_price > v.price -%}
            −{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }} %
          {%- endif -%}
        </span>
      </div>
      {%- if block.settings.afficher_3x -%}
        {%- assign tiers = v.price | divided_by: 3 -%}
        <p class="paiement-3x">
          {{ block.settings.texte_3x | default: 'ou' }} <strong id="prix-3x">{{ tiers | money }}</strong> × 3
        </p>
      {%- endif -%}
      {%- assign mention = block.settings.mention_taxes | default: 'TVA incluse' -%}
      {%- if mention != blank -%}
        <p class="form-note" style="margin:-14px 0 18px">{{ mention }}</p>
      {%- endif -%}
    </div>

  {%- when 'options' -%}
    <div {{ block.shopify_attributes }}>
      {% render 'selecteur-options', product: product, option_pastilles: block.settings.option_pastilles %}
    </div>

  {%- when 'stock' -%}
    <p class="stock {% if product.available %}stock--ok{% else %}stock--non{% endif %}"
       id="etat-stock" {{ block.shopify_attributes }}>
      {% if product.available %}En stock{% else %}Rupture de stock{% endif %}
    </p>

  {%- when 'achat' -%}
    <div {{ block.shopify_attributes }}>
      <div class="achat">
        {%- unless block.settings.afficher_quantite == false -%}
          <div class="quantite">
            <button type="button" id="qte-moins" aria-label="Diminuer la quantité">−</button>
            <label class="sr-only" for="qte-valeur">Quantité</label>
            <input id="qte-valeur" name="quantity" type="number" value="1" min="1" inputmode="numeric">
            <button type="button" id="qte-plus" aria-label="Augmenter la quantité">+</button>
          </div>
        {%- endunless -%}

        <button class="btn btn--lg" type="submit" name="add" id="ajouter-panier"
                {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}
            {{ block.settings.texte_bouton | default: 'Ajouter au panier' }}
          {%- else -%}Épuisé{%- endif -%}
        </button>
      </div>

      {%- unless block.settings.paiement_rapide == false -%}
        {{ form | payment_button }}
      {%- endunless -%}
    </div>

  {%- when 'actions' -%}
    <div class="btn-row" style="margin:16px 0 8px" {{ block.shopify_attributes }}>
      {%- unless block.settings.afficher_favoris == false -%}
        <button class="btn btn--soft btn--sm" type="button"
                data-favori="{{ product.handle }}" aria-pressed="false">
          {% render 'icon', nom: 'coeur' %} Favoris
        </button>
      {%- endunless -%}
      {%- unless block.settings.afficher_comparer == false -%}
        <button class="btn btn--soft btn--sm" type="button"
                data-comparer="{{ product.handle }}" aria-pressed="false">
          {% render 'icon', nom: 'compare' %} Comparer
        </button>
      {%- endunless -%}
    </div>

  {%- when 'points_forts' -%}
    {%- assign points = product.metafields.custom.points_forts.value -%}
    {%- if points != blank -%}
      <ul class="points-forts" {{ block.shopify_attributes }}>
        {%- for point in points -%}<li>{{ point }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}

  {%- when 'services' -%}
    <div class="services" {{ block.shopify_attributes }}>
      {%- assign s1 = block.settings.service_1 | default: 'Expédition sous 24 h' -%}
      {%- assign s2 = block.settings.service_2 | default: "30 jours pour changer d'avis" -%}
      {%- assign s3 = block.settings.service_3 | default: 'Garantie 2 ans' -%}
      {%- comment -%} Les filtres sont interdits dans les arguments de render. {%- endcomment -%}
      {%- assign icone_1 = block.settings.icone_1 | default: 'camion' -%}
      {%- assign icone_2 = block.settings.icone_2 | default: 'retour' -%}
      {%- assign icone_3 = block.settings.icone_3 | default: 'bouclier' -%}
      {%- if s1 != blank -%}
        <div class="service">{% render 'icon', nom: icone_1 %}
          <span><strong>{{ s1 }}</strong>{{ block.settings.detail_1 | default: 'Depuis notre entrepôt en France' }}</span></div>
      {%- endif -%}
      {%- if s2 != blank -%}
        <div class="service">{% render 'icon', nom: icone_2 %}
          <span><strong>{{ s2 }}</strong>{{ block.settings.detail_2 | default: 'Retour gratuit' }}</span></div>
      {%- endif -%}
      {%- if s3 != blank -%}
        <div class="service">{% render 'icon', nom: icone_3 %}
          <span><strong>{{ s3 }}</strong>{{ block.settings.detail_3 | default: 'Extension possible' }}</span></div>
      {%- endif -%}
    </div>

  {%- when 'description' -%}
    {%- if product.description != blank -%}
      <div class="prose" style="max-width:none;margin-top:20px" {{ block.shopify_attributes }}>
        {{ product.description }}
      </div>
    {%- endif -%}

  {%- when 'caracteristiques' -%}
    {%- assign specs = product.metafields.custom.caracteristiques.value -%}
    {%- if specs != blank -%}
      <div {{ block.shopify_attributes }}>
        {%- assign titre_specs = block.settings.titre | default: 'Caractéristiques' -%}
        {%- if titre_specs != blank -%}
          <h2 style="font-size:1.05rem;margin-top:24px">{{ titre_specs }}</h2>
        {%- endif -%}
        <table class="tableau-specs"><tbody>
          {%- for ligne in specs -%}
            {%- assign paire = ligne | split: ' : ' -%}
            <tr><th scope="row">{{ paire[0] }}</th><td>{{ paire[1] | default: '—' }}</td></tr>
          {%- endfor -%}
        </tbody></table>
      </div>
    {%- endif -%}

  {%- when 'texte' -%}
    {%- if block.settings.contenu != blank -%}
      <div class="prose" style="max-width:none" {{ block.shopify_attributes }}>
        {%- if block.settings.titre != blank -%}
          <h2 style="font-size:1.05rem;margin-top:24px">{{ block.settings.titre }}</h2>
        {%- endif -%}
        {{ block.settings.contenu }}
      </div>
    {%- endif -%}

  {%- when 'encart' -%}
    {%- if block.settings.texte != blank -%}
      <div class="alerte alerte--{{ block.settings.ton | default: 'info' }}" {{ block.shopify_attributes }}>
        {{ block.settings.texte }}
      </div>
    {%- endif -%}

  {%- when 'separateur' -%}
    <hr {{ block.shopify_attributes }}>

{%- endcase -%}
