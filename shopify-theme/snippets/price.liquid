{%- comment -%}
  Prix d'un produit, avec prix de référence barré s'il y a une remise.
  Paramètres : product (obligatoire)
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}

<span class="prix">
  {%- if product.price_varies -%}
    À partir de {{ product.price_min | money }}
  {%- else -%}
    {%- if v.compare_at_price > v.price -%}
      <s>{{ v.compare_at_price | money }}</s>
    {%- endif -%}
    {{ v.price | money }}
  {%- endif -%}
</span>
