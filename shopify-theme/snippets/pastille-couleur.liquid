{%- comment -%}
  Traduit un nom de coloris en code hexadécimal.

  Ce snippet ÉCRIT la valeur (il ne l'assigne pas) : `render` isole les
  variables, une assignation ne serait donc pas visible par l'appelant.
  Utilisation :
    {%- capture hex -%}{% render 'pastille-couleur', valeur: valeur %}{%- endcapture -%}
    <span style="background:{{ hex }}"></span>

  Pour ajouter vos coloris, complétez la liste : le nom est reconnu dès
  qu'il apparaît dans la valeur de l'option.
{%- endcomment -%}
{%- liquid
  assign v = valeur | downcase

  if v contains 'noir' or v contains 'black' or v contains 'sidéral'
    echo '#32343a'
  elsif v contains 'argent' or v contains 'silver'
    echo '#ced2d9'
  elsif v contains 'blanc' or v contains 'white'
    echo '#f2f3f5'
  elsif v contains 'titane' or v contains 'titanium'
    echo '#8f8778'
  elsif v contains 'bleu' or v contains 'blue'
    echo '#4a6ea8'
  elsif v contains 'vert' or v contains 'green'
    echo '#4c7d66'
  elsif v contains 'gold' or v contains 'champagne' or v contains 'doré' or v == 'or'
    echo '#c6a469'
  elsif v contains 'rouge' or v contains 'red'
    echo '#b0453f'
  elsif v contains 'rose' or v contains 'pink'
    echo '#d99aa8'
  elsif v contains 'violet' or v contains 'purple'
    echo '#8b6fc0'
  elsif v contains 'jaune' or v contains 'yellow'
    echo '#d8b24a'
  elsif v contains 'gris' or v contains 'gray' or v contains 'grey'
    echo '#7c828e'
  elsif v contains 'beige' or v contains 'crème' or v contains 'creme'
    echo '#d8cdbb'
  elsif v contains 'orange'
    echo '#cc7a3d'
  else
    echo '#6d8cff'
  endif
-%}
