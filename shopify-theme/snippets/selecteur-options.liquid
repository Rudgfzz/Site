{%- comment -%}
  Sélecteur de variantes ORBIT.

  Gère les deux générations de Shopify :
    • pastilles natives (Produits → Options → échantillon) : value.swatch.color
      ou value.swatch.image ;
    • anciennes options en texte : la couleur est déduite du nom via le
      snippet « pastille-couleur ».

  Paramètres :
    product           (obligatoire)
    option_pastilles  nom de l'option à afficher en pastilles ; vide = détection
                      automatique sur « couleur / coloris / color »
    style_autres      'bouton' ou 'liste' pour les options restantes
{%- endcomment -%}

{%- unless product.has_only_default_variant -%}
  {%- assign cible = option_pastilles | default: '' | downcase | strip -%}

  {%- for option in product.options_with_values -%}
    {%- liquid
      assign nom_option = option.name | downcase
      assign index = forloop.index0
      assign est_pastille = false

      if cible != blank
        if nom_option contains cible
          assign est_pastille = true
        endif
      else
        if nom_option contains 'couleur' or nom_option contains 'coloris' or nom_option contains 'color'
          assign est_pastille = true
        endif
      endif
    -%}

    <div class="option" data-option="{{ index }}">
      <p class="option__titre">
        {{ option.name }}
        <span id="nom-option-{{ index }}">{{ option.selected_value }}</span>
      </p>

      <div class="{% if est_pastille %}choix-couleurs{% else %}choix-capacites{% endif %}">
        {%- for valeur in option.values -%}
          {%- liquid
            # Force la conversion en texte : selon la version de l'API, une
            # valeur d'option est une chaîne ou un objet.
            assign nom_valeur = valeur | strip

            assign choisie = false
            if valeur.selected
              assign choisie = true
            elsif nom_valeur == option.selected_value
              assign choisie = true
            endif
          -%}

          {%- if est_pastille -%}
            {%- liquid
              assign fond = ''
              if valeur.swatch.color
                assign fond = valeur.swatch.color
              endif
            -%}
            {%- capture repli -%}{% render 'pastille-couleur', valeur: nom_valeur %}{%- endcapture -%}
            {%- if fond == blank -%}{%- assign fond = repli | strip -%}{%- endif -%}

            <button class="choix-couleur" type="button"
                    data-option-index="{{ index }}"
                    data-valeur="{{ nom_valeur | escape }}"
                    aria-pressed="{{ choisie }}"
                    style="background:{{ fond }}
                      {%- if valeur.swatch.image %};background-image:url({{ valeur.swatch.image | image_url: width: 80 }});background-size:cover{% endif -%}"
                    title="{{ nom_valeur | escape }}"
                    aria-label="{{ nom_valeur | escape }}"></button>
          {%- else -%}
            <button class="choix-capacite" type="button"
                    data-option-index="{{ index }}"
                    data-valeur="{{ nom_valeur | escape }}"
                    aria-pressed="{{ choisie }}">{{ nom_valeur }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}

  {%- comment -%}
    Repli sans JavaScript : un menu déroulant classique reste utilisable.
  {%- endcomment -%}
  <noscript>
    <div class="option">
      <label for="variante-secours">{{ 'products.product.choisir_version' | t }}</label>
      <select class="select" id="variante-secours" name="id">
        {%- for variante in product.variants -%}
          <option value="{{ variante.id }}"
                  {% if variante == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variante.available %}disabled{% endunless %}>
            {{ variante.title }} — {{ variante.price | money }}
          </option>
        {%- endfor -%}
      </select>
    </div>
  </noscript>
{%- endunless -%}
