{%- comment -%}
  Jeu d'icônes du thème. Utilisation : {% render 'icon', nom: 'panier' %}
{%- endcomment -%}

{%- capture traits -%}fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}

{%- case nom -%}
  {%- when 'logo' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'panier' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <path d="M6 7h12l-1 12a2 2 0 01-2 2H9a2 2 0 01-2-2L6 7z"/><path d="M9 7V5.5a3 3 0 016 0V7"/>
    </svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  {%- when 'recherche' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/>
    </svg>
  {%- when 'telechargement' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
    </svg>
  {%- when 'bouclier' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3z"/>
    </svg>
  {%- when 'actualiser' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <path d="M4 12a8 8 0 0113.7-5.7L20 8M20 4v4h-4M20 12a8 8 0 01-13.7 5.7L4 16M4 20v-4h4"/>
    </svg>
  {%- when 'eclair' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z"/>
    </svg>
  {%- when 'mobile' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <rect x="7" y="3" width="10" height="18" rx="2.5"/><path d="M11 18h2"/>
    </svg>
  {%- when 'coeur' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <path d="M12 20s-7-4.4-7-9a4 4 0 017-2.6A4 4 0 0119 11c0 4.6-7 9-7 9z"/>
    </svg>
  {%- when 'etoile' -%}
    <svg viewBox="0 0 24 24" {{ traits }} aria-hidden="true">
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9L12 3.5z"/>
    </svg>
{%- endcase -%}
