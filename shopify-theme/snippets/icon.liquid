{%- comment -%}
  Jeu d'icônes du thème. Utilisation : {% render 'icon', nom: 'panier' %}
{%- endcomment -%}

{%- capture t -%}fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}

{%- case nom -%}
  {%- when 'logo' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="7"/><circle cx="12" cy="5" r="2.2" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'panier' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M6 7h12l-1.2 12.1A2 2 0 0 1 14.8 21H9.2a2 2 0 0 1-2-1.9L6 7Z"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7"/>
    </svg>
  {%- when 'loupe' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
  {%- when 'coeur' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M12 20s-7-4.5-7-9.2A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.8C19 15.5 12 20 12 20Z"/>
    </svg>
  {%- when 'compare' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M4 7h7M4 17h7M17 4v16M14 8l3-3 3 3M20 16l-3 3-3-3"/>
    </svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'croix' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'theme' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>
    </svg>
  {%- when 'camion' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/>
    </svg>
  {%- when 'retour' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M9 5L4 10l5 5"/><path d="M4 10h10a6 6 0 0 1 0 12h-3"/>
    </svg>
  {%- when 'bouclier' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M12 3l7.5 3v6c0 4.4-3.2 7.6-7.5 9-4.3-1.4-7.5-4.6-7.5-9V6L12 3Z"/>
    </svg>
  {%- when 'casque' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M5 16v-4a7 7 0 0 1 14 0v4"/><rect x="3" y="14" width="4" height="6" rx="2"/><rect x="17" y="14" width="4" height="6" rx="2"/>
    </svg>
  {%- when 'etincelle' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4L12 3Z"/>
    </svg>
  {%- when 'colis' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M4 8l8-4 8 4v8l-8 4-8-4V8Z"/><path d="M4 8l8 4 8-4M12 12v8"/>
    </svg>
  {%- when 'carte' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18"/></svg>
  {%- when 'grille' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/>
      <rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>
    </svg>
  {%- when 'liste' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  {%- when 'valide' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>
  {%- when 'regle' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <rect x="2.5" y="8" width="19" height="8" rx="1.5"/>
      <path d="M7 8v3M11 8v4M15 8v3M19 8v4"/>
    </svg>
  {%- when 'cintre' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <path d="M12 9.5V8a2 2 0 1 1 2-2"/>
      <path d="M12 9.5 3.6 15.4a1.2 1.2 0 0 0 .7 2.2h15.4a1.2 1.2 0 0 0 .7-2.2L12 9.5Z"/>
    </svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.4"/>
      <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="M11 10l4 2-4 2v-4Z" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'x' -%}
    <svg viewBox="0 0 24 24" {{ t }} aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
{%- endcase -%}
