{%- comment -%}
  Carte produit ORBIT. Paramètres :
    product (obligatoire)
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign alt_image = product.featured_media.alt | default: product.title -%}
{%- assign note = product.metafields.reviews.rating.value -%}
{%- assign nb_avis = product.metafields.reviews.rating_count.value -%}

<article class="produit{% unless product.available %} sold-out{% endunless %}">
  <a class="produit__media" href="{{ product.url }}" aria-label="Voir {{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '300, 400, 600, 800',
          sizes: '(min-width: 990px) 300px, (min-width: 750px) 45vw, 90vw',
          alt: alt_image
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="etiquettes">
    {%- if product.available == false -%}
      <span class="etiquette etiquette--rupture">Rupture</span>
    {%- elsif v.compare_at_price > v.price -%}
      {%- assign remise = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
      <span class="etiquette etiquette--promo">−{{ remise }} %</span>
    {%- endif -%}
    {%- if product.tags contains 'nouveau' -%}
      <span class="etiquette etiquette--neuf">Nouveau</span>
    {%- endif -%}
    {%- if product.tags contains 'best-seller' -%}
      <span class="etiquette">Best-seller</span>
    {%- endif -%}
  </div>

  <div class="actions-flottantes">
    <button class="action-ronde" type="button" data-favori="{{ product.handle }}"
            aria-pressed="false" aria-label="Ajouter {{ product.title | escape }} aux favoris"
            title="Favoris">{% render 'icon', nom: 'coeur' %}</button>
    <button class="action-ronde" type="button" data-comparer="{{ product.handle }}"
            aria-pressed="false" aria-label="Comparer {{ product.title | escape }}"
            title="Comparer">{% render 'icon', nom: 'compare' %}</button>
  </div>

  <div class="produit__corps">
    <p class="produit__marque">
      {{ product.vendor }}{% if product.type != blank %} · {{ product.type }}{% endif %}
    </p>

    <h3 class="produit__nom"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    {%- if product.description != blank -%}
      <p class="produit__desc">{{ product.description | strip_html | truncate: 110 }}</p>
    {%- endif -%}

    {%- if note -%}
      {%- assign pleines = note | round -%}
      <p class="note">
        <span class="etoiles" aria-hidden="true">
          {%- for i in (1..5) -%}{% if i <= pleines %}★{% else %}☆{% endif %}{%- endfor -%}
        </span>
        <span>{{ note | round: 1 }}{% if nb_avis %} · {{ nb_avis }} avis{% endif %}</span>
      </p>
    {%- endif -%}

    {%- comment -%} Pastilles de coloris, si une option porte ce nom. {%- endcomment -%}
    {%- for option in product.options_with_values -%}
      {%- assign nom_option = option.name | downcase -%}
      {%- if nom_option contains 'couleur' or nom_option contains 'color' or nom_option contains 'coloris' -%}
        <div class="produit__couleurs" aria-hidden="true">
          {%- for valeur in option.values limit: 6 -%}
            {%- capture hex -%}{% render 'pastille-couleur', valeur: valeur %}{%- endcapture -%}
            <span class="pion" style="background:{{ hex | strip }}" title="{{ valeur | escape }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if product.available -%}
      <p class="stock stock--ok" style="margin-bottom:12px">En stock</p>
    {%- else -%}
      <p class="stock stock--non" style="margin-bottom:12px">Rupture de stock</p>
    {%- endif -%}

    <div class="produit__pied">
      {% render 'price', product: product %}

      {%- if product.available -%}
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          <button class="btn btn--soft btn--sm" type="submit" name="add">Ajouter</button>
        {%- endform -%}
      {%- else -%}
        <span class="form-note">Indisponible</span>
      {%- endif -%}
    </div>
  </div>
</article>
