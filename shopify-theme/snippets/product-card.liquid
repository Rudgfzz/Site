{%- comment -%}
  Carte produit réutilisée par l'accueil, les collections et la recherche.
  Paramètres :
    product (obligatoire)
    show_vendor (facultatif, booléen)
{%- endcomment -%}

{%- assign alt_image = product.featured_media.alt | default: product.title -%}

<article class="card{% unless product.available %} sold-out{% endunless %}">
  <a class="card__media" href="{{ product.url }}" aria-label="Voir {{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '300, 400, 600, 800',
          sizes: '(min-width: 990px) 300px, (min-width: 750px) 45vw, 90vw',
          alt: alt_image
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- comment -%} unless n'accepte pas elsif : on utilise if. {%- endcomment -%}
    {%- if product.available == false -%}
      <span class="badge badge--soldout">Épuisé</span>
    {%- elsif product.compare_at_price > product.price -%}
      {%- assign remise = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
      <span class="badge">−{{ remise }} %</span>
    {%- elsif product.tags contains 'nouveau' -%}
      <span class="badge">Nouveau</span>
    {%- endif -%}
  </a>

  <div class="card__body">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="card__cat">{{ product.vendor }}</p>
    {%- elsif product.type != blank -%}
      <p class="card__cat">{{ product.type }}</p>
    {%- endif -%}

    <h3 class="card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {%- if product.description != blank -%}
      <p class="card__desc">{{ product.description | strip_html | truncate: 110 }}</p>
    {%- endif -%}

    <div class="card__foot">
      {% render 'price', product: product %}

      {%- if product.available -%}
        {%- form 'product', product, class: 'card__form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button class="btn btn--soft btn--sm" type="submit" name="add">Ajouter</button>
        {%- endform -%}
      {%- else -%}
        <span class="form-note">Indisponible</span>
      {%- endif -%}
    </div>
  </div>
</article>
