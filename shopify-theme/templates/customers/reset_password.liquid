<section class="section">
  <div class="container" style="max-width:460px">
    <h1 style="font-size:1.7rem;text-align:center">Nouveau mot de passe</h1>
    <p class="lead" style="text-align:center">Choisissez un nouveau mot de passe pour votre compte.</p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="alerte alerte--err">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label for="reset-password">Mot de passe</label>
        <input class="input" id="reset-password" type="password" name="customer[password]"
               autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="reset-confirm">Confirmation</label>
        <input class="input" id="reset-confirm" type="password" name="customer[password_confirmation]"
               autocomplete="new-password" required>
      </div>

      <button class="btn btn--block btn--lg" type="submit">Enregistrer</button>
    {%- endform -%}
  </div>
</section>
