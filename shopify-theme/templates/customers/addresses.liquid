<section class="section">
  <div class="container" style="max-width:720px">
    <nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding-top:0">
      <a href="{{ routes.account_url }}">Mon compte</a><span>/</span>Mes adresses
    </nav>

    <h1 style="font-size:clamp(1.5rem,3.2vw,2.1rem);margin-top:18px">Mes adresses</h1>

    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div class="info-card" style="margin-bottom:16px">
          {%- if address == customer.default_address -%}
            <p class="eyebrow" style="margin-bottom:8px">Adresse par défaut</p>
          {%- endif -%}
          {{ address | format_address }}

          {%- form 'customer_address', address -%}
            <div class="btn-row" style="margin-top:12px">
              <button class="btn btn--ghost btn--sm" type="submit" name="delete">Supprimer</button>
            </div>
          {%- endform -%}
        </div>
      {%- else -%}
        <p class="empty-state">Aucune adresse enregistrée.</p>
      {%- endfor -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}

    <details class="faq" style="margin-top:26px">
      <summary>Ajouter une adresse</summary>
      {%- form 'customer_address', customer.new_address -%}
        <div class="field">
          <label for="adr-prenom">Prénom</label>
          <input class="input" id="adr-prenom" type="text" name="address[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label for="adr-nom">Nom</label>
          <input class="input" id="adr-nom" type="text" name="address[last_name]" autocomplete="family-name">
        </div>
        <div class="field">
          <label for="adr-rue">Adresse</label>
          <input class="input" id="adr-rue" type="text" name="address[address1]" autocomplete="address-line1">
        </div>
        <div class="field">
          <label for="adr-cp">Code postal</label>
          <input class="input" id="adr-cp" type="text" name="address[zip]" autocomplete="postal-code">
        </div>
        <div class="field">
          <label for="adr-ville">Ville</label>
          <input class="input" id="adr-ville" type="text" name="address[city]" autocomplete="address-level2">
        </div>
        <div class="field">
          <label for="adr-pays">Pays</label>
          <select class="select" id="adr-pays" name="address[country]" autocomplete="country">
            {{ country_option_tags }}
          </select>
        </div>
        <button class="btn" type="submit">Enregistrer</button>
      {%- endform -%}
    </details>

    <p style="margin-top:26px">
      <a class="btn btn--ghost" href="{{ routes.account_url }}">← Retour à mon compte</a>
    </p>
  </div>
</section>
