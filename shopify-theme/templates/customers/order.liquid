<section class="section">
  <div class="container">
    <nav class="fil" aria-label="Fil d'Ariane" style="padding-top:0">
      <a href="{{ routes.account_url }}">Mon compte</a><span>/</span>{{ order.name }}
    </nav>

    <h1 style="font-size:clamp(1.5rem,3.2vw,2.1rem);margin-top:18px">Commande {{ order.name }}</h1>
    <p class="lead">Passée le {{ order.created_at | date: '%d/%m/%Y' }} · {{ order.financial_status_label }}</p>

    {%- for item in order.line_items -%}
      <div class="ligne">
        <a class="ligne__img" href="{{ item.product.url }}">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 200 }}" loading="lazy"
                 width="200" height="150"
                 alt="{{ item.title | escape }}">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
        <div>
          <p class="ligne__nom">{{ item.title }}</p>
          <p class="ligne__meta">Quantité : {{ item.quantity }}</p>
        </div>
        <div class="ligne__fin">
          <strong class="price">{{ item.final_line_price | money }}</strong>
        </div>
      </div>
    {%- endfor -%}

    <div class="recap" style="max-width:340px;margin-top:26px;position:static">
      <div class="recap__ligne"><span>Sous-total</span><span>{{ order.subtotal_price | money }}</span></div>
      {%- for tax in order.tax_lines -%}
        <div class="recap__ligne"><span>{{ tax.title }}</span><span>{{ tax.price | money }}</span></div>
      {%- endfor -%}
      <div class="recap__total"><span>Total</span><span>{{ order.total_price | money_with_currency }}</span></div>
    </div>

    <p style="margin-top:26px">
      <a class="btn btn--ghost" href="{{ routes.account_url }}">← Retour à mon compte</a>
    </p>
  </div>
</section>
