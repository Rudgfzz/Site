{%- comment -%}
  Jeu d'icônes. Utilisation : {% render 'icone', nom: 'panier' %}
  Tracé uniforme : 24×24, contour de 1.5, extrémités arrondies.
{%- endcomment -%}

{%- capture a -%}fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}

{%- case nom -%}
  {%- when 'panier' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M5.5 7.5h13l-1 12h-11l-1-12Z"/><path d="M9 7.5V6a3 3 0 0 1 6 0v1.5"/></svg>
  {%- when 'loupe' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
  {%- when 'croix' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M3 8h18M3 16h18"/></svg>
  {%- when 'compte' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><circle cx="12" cy="8.5" r="3.6"/><path d="M4.8 20a7.4 7.4 0 0 1 14.4 0"/></svg>
  {%- when 'fleche-droite' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'fleche-gauche' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
  {%- when 'fleche-haut' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M14 4v10.2a3.4 3.4 0 1 1-2.8-3.35"/><path d="M14 4c.4 2.2 1.9 3.7 4.2 3.9"/></svg>
  {%- when 'pinterest' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M10.4 20.2 12.6 12"/><path d="M9.4 11.2c-.5-1.9.6-3.6 2.5-3.9 1.9-.3 3.4.8 3.6 2.6.2 2.2-1 4.2-2.9 4.3-1 .1-1.8-.6-1.6-1.6"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><path d="M14.8 8.4h2.1M14.8 8.4V6.9c0-.9.6-1.4 1.5-1.4h1.3"/><path d="M14.8 8.4v10.1"/><path d="M11.4 11.6h5.9"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" {{ a }} aria-hidden="true"><circle cx="12" cy="12" r="8.5"/></svg>
{%- endcase -%}
