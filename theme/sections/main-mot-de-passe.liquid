{%- comment -%} Page « boutique protégée ». {%- endcomment -%}

<section class="section" style="min-height:80svh;display:grid;place-items:center;text-align:center">
  <div class="enveloppe enveloppe--etroite">
    <h1 class="titre-moyen" style="margin-bottom:16px">{{ section.settings.titre }}</h1>

    {%- if section.settings.texte != blank -%}
      <div class="prose doux" style="margin-inline:auto">{{ section.settings.texte }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="message" style="margin-top:22px">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:26px">
        <label class="lecteur-seul" for="mot-de-passe">{{ 'clients.compte.mot_de_passe' | t }}</label>
        <input id="mot-de-passe" type="password" name="password" required
               style="padding:16px;border:var(--filet);background:transparent;font:inherit;min-width:240px">
        <button class="bouton" type="submit">{{ section.settings.bouton }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Mot de passe",
  "settings": [
    { "type": "text", "id": "titre", "label": "Titre", "default": "Bientôt ouvert" },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>La boutique ouvre très prochainement.</p>"
    },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Entrer" }
  ]
}
{% endschema %}
