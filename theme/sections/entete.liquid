{%- comment -%}
  En-tête. Sur les pages qui ouvrent par un chapitre plein écran, il se
  superpose à l'image puis reprend un fond dès qu'on défile.
{%- endcomment -%}

{%- assign transparent = false -%}
{%- if section.settings.transparent_accueil and template.name == 'index' -%}
  {%- assign transparent = true -%}
{%- endif -%}

<header class="entete" data-entete data-transparent="{{ transparent }}"
        style="--logo-largeur:{{ settings.logo_largeur | default: 140 }}px">
  <div class="enveloppe entete__grille">
    <nav class="nav" data-nav aria-label="{{ section.settings.titre_menu | escape }}">
      <button class="bouton-icone burger" type="button" data-burger
              aria-label="{{ 'general.navigation.fermer' | t }}" aria-expanded="false"
              style="position:absolute;top:14px;right:var(--marge)">
        {% render 'icone', nom: 'croix' %}
      </button>

      {%- for lien in section.settings.menu.links -%}
        <a href="{{ lien.url }}" {% if lien.active %}aria-current="page"{% endif %}>{{ lien.title }}</a>
      {%- endfor -%}
    </nav>

    <button class="bouton-icone burger" type="button" data-burger
            aria-label="{{ 'general.navigation.menu' | t }}" aria-expanded="false">
      {% render 'icone', nom: 'menu' %}
    </button>

    <a class="entete__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 400 }}"
             width="400" height="100"
             alt="{{ shop.name | escape }}">
      {%- else -%}
        {{ settings.logo_texte | default: shop.name }}
      {%- endif -%}
    </a>

    <div class="entete__actions">
      {%- if section.settings.afficher_recherche -%}
        <button class="bouton-icone" type="button" data-ouvrir-recherche
                aria-label="{{ 'general.recherche.ouvrir' | t }}">
          {% render 'icone', nom: 'loupe' %}
        </button>
      {%- endif -%}

      {%- if section.settings.afficher_compte and shop.customer_accounts_enabled -%}
        <a class="bouton-icone" href="{{ routes.account_url }}"
           aria-label="{{ 'clients.compte.titre' | t }}">
          {% render 'icone', nom: 'compte' %}
        </a>
      {%- endif -%}

      <button class="bouton-icone" type="button" data-ouvrir-panier
              aria-label="{{ 'panier.general.ouvrir' | t }}">
        {% render 'icone', nom: 'panier' %}
        <span class="compteur" data-compteur-panier {% if cart.item_count == 0 %}hidden{% endif %}>
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "titre_menu", "label": "Nom du menu (lecteurs d'écran)", "default": "Menu principal" },
    {
      "type": "checkbox",
      "id": "transparent_accueil",
      "label": "Superposer à l'image d'accueil",
      "info": "L'en-tête devient transparent au-dessus du premier chapitre de la page d'accueil.",
      "default": true
    },
    { "type": "checkbox", "id": "afficher_recherche", "label": "Bouton recherche", "default": true },
    { "type": "checkbox", "id": "afficher_compte", "label": "Bouton compte client", "default": true }
  ]
}
{% endschema %}
