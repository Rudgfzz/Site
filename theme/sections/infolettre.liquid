{%- comment -%}
  Inscription à l'infolettre, en pleine largeur.
{%- endcomment -%}

<section class="section{% if section.settings.fond == 'sombre' %} section--sombre{% elsif section.settings.fond == 'teinte' %} section--teinte{% endif %}">
  <div class="enveloppe enveloppe--etroite" style="text-align:center">
    {%- if section.settings.numero != blank -%}
      <p class="numero" data-anim>{{ section.settings.numero }}</p>
    {%- endif -%}

    <h2 class="titre-moyen" style="margin:14px 0 16px" data-anim>{{ section.settings.titre }}</h2>

    {%- if section.settings.texte != blank -%}
      <div class="prose doux" style="margin-inline:auto" data-anim>{{ section.settings.texte }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'formulaire-infolettre' -%}
      <input type="hidden" name="contact[tags]" value="infolettre">

      {%- if form.posted_successfully? -%}
        <p class="message" style="margin-top:26px">{{ 'general.infolettre.confirmation' | t }}</p>
      {%- else -%}
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:30px" data-anim>
          <label class="lecteur-seul" for="infolettre-email">{{ 'general.infolettre.placeholder' | t }}</label>
          <input id="infolettre-email" type="email" name="contact[email]" required
                 placeholder="{{ 'general.infolettre.placeholder' | t | escape }}"
                 style="flex:1;min-width:240px;max-width:360px;padding:16px;border:var(--filet);background:transparent;color:inherit;font:inherit">
          <button class="bouton" type="submit">{{ section.settings.bouton }}</button>
        </div>

        {%- if form.errors -%}
          <p class="message" style="margin-top:18px">{{ 'general.infolettre.erreur' | t }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.mention != blank -%}
      <p class="doux" style="margin-top:16px;font-size:.78rem">{{ section.settings.mention }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Infolettre",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "numero", "label": "Numéro", "default": "07" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Les arrivages, avant tout le monde" },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>Un message quand une pièce arrive ou qu'une taille est réapprovisionnée. Rien d'autre.</p>"
    },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Je m'inscris" },
    { "type": "text", "id": "mention", "label": "Mention", "default": "Désinscription en un clic. Aucune revente de données." },
    {
      "type": "select",
      "id": "fond",
      "label": "Fond",
      "options": [
        { "value": "normal", "label": "Fond de page" },
        { "value": "teinte", "label": "Teinté" },
        { "value": "sombre", "label": "Sombre" }
      ],
      "default": "teinte"
    }
  ],
  "presets": [{ "name": "Infolettre" }]
}
{% endschema %}
