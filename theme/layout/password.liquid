<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- endif -%}
  {{ 'rivage.css' | asset_url | stylesheet_tag }}
  {{ settings.police_titres | font_face: font_display: 'swap' }}
  {{ settings.police_texte | font_face: font_display: 'swap' }}

  {% style %}
    :root {
      --fond: {{ settings.c_fond }};
      --fond-2: {{ settings.c_fond_2 }};
      --encre: {{ settings.c_encre }};
      --texte: {{ settings.c_texte }};
      --texte-doux: {{ settings.c_texte_doux }};
      --texte-clair: {{ settings.c_texte_clair }};
      --accent: {{ settings.c_accent }};
      --accent-texte: {{ settings.c_accent_texte }};
      --filet: 1px solid {{ settings.c_trait | color_modify: 'alpha', 0.15 }};
      --police-titres: {{ settings.police_titres.family }}, {{ settings.police_titres.fallback_families }};
      --police-texte: {{ settings.police_texte.family }}, {{ settings.police_texte.fallback_families }};
      --titre-graisse: {{ settings.titre_graisse }};
      --titre-interligne: {{ settings.titre_interligne | divided_by: 100.0 }};
      --titre-espacement: {{ settings.titre_espacement | divided_by: 1000.0 }}em;
      --titre-casse: {{ settings.titre_casse }};
      --texte-taille: {{ settings.texte_taille }}px;
      --texte-interligne: {{ settings.texte_interligne | divided_by: 100.0 }};
      --largeur: {{ settings.largeur_max }}px;
      --marge: {{ settings.marge_laterale }}px;
      --espace: {{ settings.espace_sections }}px;
      --arrondi: {{ settings.arrondi }}px;
      --anim-distance: 0px;
      --anim-duree: 0ms;
    }
  {% endstyle %}

  {{ content_for_header }}
</head>
<body class="modele-mot-de-passe">
  <main id="contenu">
    {{ content_for_layout }}
  </main>
</body>
</html>
