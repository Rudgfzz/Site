<footer class="pied">
  <div class="zone">
    <div class="pied__grille">
      <div>
        <span class="etiquette-technique">{{ section.settings.surtitre }}</span>
        <p class="titre-m" style="margin:10px 0 12px">{{ section.settings.titre }}</p>
        {%- if section.settings.texte != blank -%}
          <div class="prose douce" style="font-size:.9rem">{{ section.settings.texte }}</div>
        {%- endif -%}

        {%- if section.settings.afficher_lettre -%}
          {%- form 'customer', style: 'margin-top:20px;max-width:330px' -%}
            <input type="hidden" name="contact[tags]" value="infolettre">
            {%- if form.posted_successfully? -%}
              <p class="avis-message">{{ 'general.lettre.merci' | t }}</p>
            {%- else -%}
              <label class="champ">
                <span>{{ section.settings.titre_lettre }}</span>
                <input type="email" name="contact[email]" required
                       placeholder="{{ 'general.lettre.placeholder' | t | escape }}">
              </label>
              <button class="bouton bouton--petit" type="submit">{{ 'general.lettre.bouton' | t }}</button>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if settings.rs_instagram != blank or settings.rs_tiktok != blank or settings.rs_pinterest != blank -%}
          <div class="reseaux">
            {%- if settings.rs_instagram != blank -%}
              <a href="{{ settings.rs_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icone', nom: 'instagram' %}</a>
            {%- endif -%}
            {%- if settings.rs_tiktok != blank -%}
              <a href="{{ settings.rs_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icone', nom: 'tiktok' %}</a>
            {%- endif -%}
            {%- if settings.rs_pinterest != blank -%}
              <a href="{{ settings.rs_pinterest }}" aria-label="Pinterest" rel="noopener" target="_blank">{% render 'icone', nom: 'pinterest' %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <p class="pied__titre">{{ block.settings.titre }}</p>
          <ul class="pied__liens">
            {%- for lien in block.settings.menu.links -%}
              <li><a href="{{ lien.url }}">{{ lien.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="pied__bas">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — {{ section.settings.mention }}</p>
      <p>{{ powered_by_link }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Atelier" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Des pièces mesurées, pas approximées" },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>Chaque article est mesuré à plat, taille par taille. Vous savez ce que vous recevez.</p>"
    },
    { "type": "checkbox", "id": "afficher_lettre", "label": "Formulaire d'inscription", "default": true },
    { "type": "text", "id": "titre_lettre", "label": "Titre du formulaire", "default": "Recevoir les arrivages" },
    { "type": "text", "id": "mention", "label": "Mention légale", "default": "Tous droits réservés." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
