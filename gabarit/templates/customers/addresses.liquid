<section class="bloc bloc--serre"><div class="zone zone--etroite">
  <h1 class="titre-l" style="margin-bottom:22px">{{ 'clients.compte.adresses' | t }}</h1>
  {%- paginate customer.addresses by 6 -%}
    {%- for adresse in customer.addresses -%}
      <div style="padding-block:18px;border-top:var(--filet)">{{ adresse | format_address }}</div>
    {%- endfor -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}

  {%- form 'customer_address', customer.new_address -%}
    {%- if form.errors -%}<p class="avis-message">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="champ"><span>{{ 'clients.compte.prenom' | t }}</span>
      <input type="text" name="address[first_name]" autocomplete="given-name"></label>
    <label class="champ"><span>{{ 'clients.compte.nom' | t }}</span>
      <input type="text" name="address[last_name]" autocomplete="family-name"></label>
    <label class="champ"><span>{{ 'clients.compte.adresses' | t }}</span>
      <input type="text" name="address[address1]" autocomplete="address-line1"></label>
    <button class="bouton" type="submit">{{ 'clients.compte.valider' | t }}</button>
  {%- endform -%}
  <p style="margin-top:20px"><a class="lien-souligne" href="{{ routes.account_url }}">{{ 'clients.compte.retour' | t }}</a></p>
</div></section>
