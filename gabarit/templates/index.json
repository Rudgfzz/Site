        "q1": {
          "type": "question",
          "settings": {
            "question": "Comment choisir ma taille ?",
            "reponse": "<p>Chaque fiche affiche les mesures du vêtement à plat. Comparez-les à une pièce que vous portez déjà : c'est plus fiable qu'une correspondance générale.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Ma taille est-elle enregistrée quelque part ?",
            "reponse": "<p>Uniquement dans votre navigateur. Elle n'est transmise à personne et disparaît si vous effacez vos données de navigation.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Quels sont les délais de livraison ?",
            "reponse": "<p>Les commandes passées avant 15 h partent le jour ouvré suivant. Comptez ensuite 2 à 4 jours ouvrés en France métropolitaine.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Comment retourner un article ?",
            "reponse": "<p>Vous disposez de 14 jours après réception. L'article doit être non porté, étiquette attachée. L'étiquette de retour est prépayée.</p>"
          }
        }
      },
